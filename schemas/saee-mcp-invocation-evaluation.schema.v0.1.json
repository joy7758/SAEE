{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-mcp-invocation-evaluation.schema.v0.1.json",
  "title": "SAEE MCP Local Invocation Evaluation Scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_mcp_invocation_evaluation_scenario_v0_1",
    "evaluation_version",
    "scenario_id",
    "caller_type",
    "synthetic_caller",
    "mcp_tool_discovery",
    "mcp_request",
    "additional_mcp_requests",
    "expected_response",
    "interpretation_result",
    "boundary_result",
    "expected_outcome"
  ],
  "properties": {
    "saee_mcp_invocation_evaluation_scenario_v0_1": {"const": true},
    "evaluation_version": {"const": "0.1"},
    "scenario_id": {"type": "string", "pattern": "^mcp-invocation:synthetic:[a-z0-9-]+$", "maxLength": 128},
    "caller_type": {
      "enum": [
        "CORRECT_MCP_AGENT",
        "WRONG_TOOL_SELECTION_AGENT",
        "RESPONSE_OVERINTERPRETATION_AGENT",
        "INVALID_MCP_CALLER",
        "BOUNDARY_AWARE_AGENT"
      ]
    },
    "synthetic_caller": {"const": true},
    "mcp_tool_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_object_ref",
        "mapping_ref",
        "request_schema_ref",
        "response_schema_ref",
        "discovered_tools",
        "selected_tool"
      ],
      "properties": {
        "capability_object_ref": {"$ref": "#/$defs/local_ref"},
        "mapping_ref": {"$ref": "#/$defs/local_ref"},
        "request_schema_ref": {"$ref": "#/$defs/local_ref"},
        "response_schema_ref": {"$ref": "#/$defs/local_ref"},
        "discovered_tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 96}
        },
        "selected_tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 96}
      }
    },
    "mcp_request": {"$ref": "#/$defs/candidate_request"},
    "additional_mcp_requests": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "request", "expected_response"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 64},
          "request": {"$ref": "#/$defs/candidate_request"},
          "expected_response": {"$ref": "#/$defs/expected_response"}
        }
      }
    },
    "expected_response": {"$ref": "#/$defs/expected_response"},
    "interpretation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "statement", "treats_result_as_authority"],
      "properties": {
        "conclusion": {
          "enum": [
            "EVIDENCE_PROFILE_REQUIREMENTS_SATISFIED",
            "EVIDENCE_INSUFFICIENT",
            "REQUEST_REJECTED",
            "DEPLOYMENT_APPROVED",
            "ACTION_AUTHORIZED",
            "SYSTEM_CERTIFIED",
            "SYSTEM_SAFE"
          ]
        },
        "statement": {"type": "string", "minLength": 1, "maxLength": 512},
        "treats_result_as_authority": {"type": "boolean"}
      }
    },
    "boundary_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserves_evaluation_approval_separation",
        "authorization_claimed",
        "deployment_claimed",
        "certification_claimed",
        "human_authority_retained"
      ],
      "properties": {
        "preserves_evaluation_approval_separation": {"type": "boolean"},
        "authorization_claimed": {"type": "boolean"},
        "deployment_claimed": {"type": "boolean"},
        "certification_claimed": {"type": "boolean"},
        "human_authority_retained": {"type": "boolean"}
      }
    },
    "expected_outcome": {"enum": ["PASS", "FAIL", "REJECTED_INPUT"]}
  },
  "$defs": {
    "local_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "candidate_request": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "tool_name": {"type": "string", "minLength": 1, "maxLength": 96},
        "arguments": {}
      }
    },
    "expected_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_result", "claim_assessment", "reason_codes"],
      "properties": {
        "tool_result": {"enum": ["SUCCESS", "REJECTED_INPUT"]},
        "claim_assessment": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE", "UNKNOWN"]},
        "reason_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:MCP|TOOL|EVIDENCE)_[A-Z0-9_]+$", "maxLength": 96}
        }
      }
    }
  }
}
