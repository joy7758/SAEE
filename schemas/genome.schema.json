{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/saee/genome.schema.json",
  "title": "SAEE Genome",
  "type": "object",
  "required": ["id", "version", "subsystems", "traits", "safety_boundaries"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "subsystems": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "traits": {
      "type": "array",
      "items": {"$ref": "trait.schema.json"},
      "default": []
    },
    "parents": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "safety_boundaries": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    }
  }
}

