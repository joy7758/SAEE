{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-external-validation-simulation-record.schema.v0.1.json",
  "title": "SAEE First External Validation Simulation Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["simulation_id", "candidate_type", "candidate", "scenario_results", "feedback_records", "integration_observations", "limitations", "evidence_boundary"],
  "properties": {
    "simulation_id": {"const": "saee.first-external-validation-simulation.v1"},
    "candidate_type": {"const": "mcp_agent_developer"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_type", "simulation_only"],
      "properties": {
        "candidate_id": {"const": "synthetic-candidate:mcp-agent-developer-001"},
        "candidate_type": {"const": "mcp_agent_developer"},
        "simulation_only": {"const": true}
      }
    },
    "scenario_results": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "outcome", "reason_code", "matched_expected", "evidence_ref"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "outcome": {"enum": ["DISCOVERED", "INVOKED", "INTERPRETED", "REJECTED_BOUNDARY", "REJECTED", "FEEDBACK_CREATED"]},
          "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "matched_expected": {"const": true},
          "evidence_ref": {"type": "string", "pattern": "^simulation-evidence:[a-z0-9-]+$"}
        }
      }
    },
    "feedback_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discovery_feedback", "integration_feedback", "documentation_feedback", "boundary_feedback", "simulation_only"],
        "properties": {
          "discovery_feedback": {"const": "CLEAR"},
          "integration_feedback": {"const": "WORKS_LOCALLY"},
          "documentation_feedback": {"const": "CLEAR"},
          "boundary_feedback": {"const": "PRESERVED"},
          "simulation_only": {"const": true}
        }
      }
    },
    "integration_observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5, "maxLength": 240}
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5, "maxLength": 240}
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_validation_simulation", "synthetic_candidate", "external_validation", "participant_contact", "real_external_agent", "customer_data", "adoption_validated", "production_ready", "network_accessed", "external_execution"],
      "properties": {
        "external_validation_simulation": {"const": true},
        "synthetic_candidate": {"const": true},
        "external_validation": {"const": false},
        "participant_contact": {"const": false},
        "real_external_agent": {"const": false},
        "customer_data": {"const": false},
        "adoption_validated": {"const": false},
        "production_ready": {"const": false},
        "network_accessed": {"const": false},
        "external_execution": {"const": false}
      }
    }
  }
}
