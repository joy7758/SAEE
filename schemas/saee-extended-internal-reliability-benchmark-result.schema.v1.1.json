{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-extended-internal-reliability-benchmark-result.schema.v1.1.json",
  "title": "SAEE Extended Internal Reliability Benchmark Result v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version", "benchmark_id", "extends_benchmark", "internal_benchmark", "public_benchmark",
    "agents_count", "scenarios_count", "base_repetitions", "additional_repetitions", "combined_repetitions",
    "base_runs", "additional_runs_attempted", "combined_runs_attempted", "runs_completed", "runs_failed",
    "run_manifest_coverage", "failure_taxonomy_coverage", "dimensions_evaluated", "dimension_statistics",
    "new_run_manifests_reference", "combined_run_manifests_reference", "combined_assessments_reference",
    "failure_distribution_reference", "report_reference", "methodology_review_reference", "methodology_conditions_satisfied",
    "recovery_opportunity_recorded_for_new_runs", "scenario_strata_preserved", "leaderboard_generated",
    "ranking_generated", "overall_score_generated", "winner_selected", "certification", "production_ready",
    "external_validation_completed", "population_reliability_probability_established"
  ],
  "properties": {
    "benchmark_version": {"const": "1.1"},
    "benchmark_id": {"const": "saee-extended-internal-reliability-v1.1"},
    "extends_benchmark": {"const": "saee-internal-reliability-v1.0"},
    "internal_benchmark": {"const": true},
    "public_benchmark": {"const": false},
    "agents_count": {"const": 3},
    "scenarios_count": {"const": 5},
    "base_repetitions": {"const": 3},
    "additional_repetitions": {"const": 2},
    "combined_repetitions": {"const": 5},
    "base_runs": {"const": 45},
    "additional_runs_attempted": {"const": 30},
    "combined_runs_attempted": {"const": 75},
    "runs_completed": {"type": "integer", "minimum": 0, "maximum": 75},
    "runs_failed": {"type": "integer", "minimum": 0, "maximum": 75},
    "run_manifest_coverage": {"const": 1.0},
    "failure_taxonomy_coverage": {"const": 1.0},
    "dimensions_evaluated": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["task_execution_reliability", "recovery_reliability", "boundary_reliability", "evidence_reliability", "assessment_availability"]}},
    "dimension_statistics": {"type": "object", "minProperties": 5, "maxProperties": 5},
    "new_run_manifests_reference": {"const": "agent-interface/reliability/benchmark-runs/v1.1/saee-extended-internal-reliability-new-run-manifests.v1.1.json"},
    "combined_run_manifests_reference": {"const": "agent-interface/reliability/benchmark-runs/v1.1/saee-extended-internal-reliability-combined-run-manifests.v1.1.json"},
    "combined_assessments_reference": {"const": "agent-interface/reliability/benchmark-runs/v1.1/saee-extended-internal-reliability-assessments.v1.1.json"},
    "failure_distribution_reference": {"const": "agent-interface/reliability/benchmark-runs/v1.1/saee-extended-internal-reliability-failure-distribution.v1.1.json"},
    "report_reference": {"const": "docs/research/SAEE_EXTENDED_INTERNAL_RELIABILITY_BENCHMARK_REPORT_V1_1.md"},
    "methodology_review_reference": {"const": "agent-interface/reliability/methodology/saee-internal-reliability-methodology-review.v1.0.json"},
    "methodology_conditions_satisfied": {"const": true},
    "recovery_opportunity_recorded_for_new_runs": {"const": true},
    "scenario_strata_preserved": {"const": true},
    "leaderboard_generated": {"const": false},
    "ranking_generated": {"const": false},
    "overall_score_generated": {"const": false},
    "winner_selected": {"const": false},
    "certification": {"const": false},
    "production_ready": {"const": false},
    "external_validation_completed": {"const": false},
    "population_reliability_probability_established": {"const": false}
  }
}
