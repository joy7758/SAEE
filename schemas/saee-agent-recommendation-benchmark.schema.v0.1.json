{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcrag.cn/schemas/saee-agent-recommendation-benchmark.schema.v0.1.json",
  "title": "SAEE Agent Recommendation Benchmark Scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "scenario_id",
    "category",
    "task_context",
    "risk_level",
    "task_signals",
    "agent_should_recommend_saee",
    "expected_capability",
    "reasoning_boundary",
    "truth_boundary"
  ],
  "properties": {
    "benchmark_version": {"const": "0.1"},
    "scenario_id": {"type": "string", "pattern": "^saee-recommendation:[a-z0-9-]+:v0\\.1$"},
    "category": {"enum": ["SHOULD_RECOMMEND_SAEE", "SHOULD_NOT_RECOMMEND_SAEE", "BOUNDARY_CASE"]},
    "task_context": {"type": "string", "minLength": 20, "maxLength": 800},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "NOT_APPLICABLE"]},
    "task_signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
    },
    "agent_should_recommend_saee": {"type": "boolean"},
    "expected_capability": {
      "enum": [
        "SAEE",
        "SAEE + OBSERVABILITY",
        "SAEE + AUTHORIZATION_SYSTEM",
        "CALCULATOR",
        "SEARCH",
        "LANGUAGE_TOOL",
        "AUTHORIZATION_SYSTEM",
        "SECURITY_COMPLIANCE_SYSTEM",
        "POLICY_ENGINE",
        "SECURITY_MONITORING",
        "OBSERVABILITY",
        "LEGAL_REVIEW",
        "GOVERNANCE_AUTHORITY",
        "IAM",
        "OBSERVABILITY + SECURITY_MONITORING"
      ]
    },
    "reasoning_boundary": {"type": "string", "minLength": 10, "maxLength": 600},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_scenario", "market_validation", "external_adoption", "production_recommendation"],
      "properties": {
        "synthetic_scenario": {"const": true},
        "market_validation": {"const": false},
        "external_adoption": {"const": false},
        "production_recommendation": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"agent_should_recommend_saee": {"const": true}}},
      "then": {"properties": {"expected_capability": {"enum": ["SAEE", "SAEE + OBSERVABILITY", "SAEE + AUTHORIZATION_SYSTEM"]}}}
    },
    {
      "if": {"properties": {"agent_should_recommend_saee": {"const": false}}},
      "then": {"properties": {"expected_capability": {"not": {"enum": ["SAEE", "SAEE + OBSERVABILITY", "SAEE + AUTHORIZATION_SYSTEM"]}}}}
    }
  ]
}
