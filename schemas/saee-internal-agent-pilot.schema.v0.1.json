{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcrag.cn/schemas/saee-internal-agent-pilot.schema.v0.1.json",
  "title": "SAEE Internal Agent Pilot Scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilot_id", "agent_type", "task_type", "workflow_scope", "scenario", "execution_environment", "evidence_policy", "limitations", "truth_boundary"],
  "properties": {
    "pilot_id": {"type": "string", "pattern": "^saee:internal-agent-pilot:[a-z0-9_-]+$"},
    "agent_type": {"enum": ["coding_agent", "research_agent", "automation_agent", "evaluation_agent"]},
    "task_type": {"type": "string", "minLength": 1},
    "workflow_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["customer_data", "production_system", "external_side_effect", "permission_expansion", "untrusted_code_execution"]}}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "objective", "evaluation_dimensions"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "objective": {"type": "string", "minLength": 1},
        "evaluation_dimensions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["execution", "evidence", "recovery", "boundary", "traceability", "tool_usage", "delegation"]}}
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_type", "network_access", "external_world_actions", "customer_data"],
      "properties": {
        "environment_type": {"const": "local_controlled"},
        "network_access": {"const": false},
        "external_world_actions": {"const": false},
        "customer_data": {"const": false}
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_required", "reliability_evaluation_required", "evidence_evaluation_required", "recommendation_required", "raw_secret_storage"],
      "properties": {
        "observation_required": {"const": true},
        "reliability_evaluation_required": {"const": true},
        "evidence_evaluation_required": {"const": true},
        "recommendation_required": {"const": true},
        "raw_secret_storage": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_agent_pilot", "pilot_executed", "external_validation", "external_participants", "customer_data", "production_execution", "adoption_validated", "production_ready"],
      "properties": {
        "internal_agent_pilot": {"const": true},
        "pilot_executed": {"const": false},
        "external_validation": {"const": false},
        "external_participants": {"const": false},
        "customer_data": {"const": false},
        "production_execution": {"const": false},
        "adoption_validated": {"const": false},
        "production_ready": {"const": false}
      }
    }
  }
}
