{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-external-validation-entry-decision.schema.v0.1.json",
  "title": "SAEE External Validation Entry Decision v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_version", "readiness_reference", "entry_decision_simulation_reference", "gap_summary", "evidence_summary", "independent_review_required", "independent_review_completed", "decision", "decision_rationale", "current_gaps", "limitations", "truth_boundary"],
  "properties": {
    "review_version": {"const": "0.1"},
    "readiness_reference": {"const": "agent-interface/ecosystem/saee-external-validation-readiness-review.v0.1.json"},
    "entry_decision_simulation_reference": {"const": "agent-interface/ecosystem/saee-entry-decision-simulation-result.v0.1.json"},
    "gap_summary": {"type": "object", "additionalProperties": false, "required": ["required", "critical", "verified_closed"], "properties": {"required":{"type":"integer","minimum":0},"critical":{"type":"integer","minimum":0},"verified_closed":{"type":"integer","minimum":0}}},
    "evidence_summary": {"type": "object", "additionalProperties": false, "required": ["closure_records", "independently_verified_records"], "properties": {"closure_records":{"type":"integer","minimum":0},"independently_verified_records":{"type":"integer","minimum":0}}},
    "independent_review_required": {"const": true},
    "independent_review_completed": {"type": "boolean"},
    "decision": {"enum": ["HOLD", "CONDITIONAL_ENTRY_REVIEW", "ENTRY_READY"]},
    "decision_rationale": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 280}},
    "current_gaps": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVR-[A-Z]+-[0-9]{3}$"}},
    "limitations": {"type": "array", "minItems": 3, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "truth_boundary": {
      "type":"object","additionalProperties":false,
      "required":["entry_decision_review","external_validation","execution_authorized","participants_invited","external_agents_connected","customer_validated","adoption_validated","production_ready"],
      "properties":{"entry_decision_review":{"const":true},"external_validation":{"const":false},"execution_authorized":{"const":false},"participants_invited":{"const":0},"external_agents_connected":{"const":false},"customer_validated":{"const":false},"adoption_validated":{"const":false},"production_ready":{"const":false}}
    }
  }
}
