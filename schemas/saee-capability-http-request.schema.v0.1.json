{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-capability-http-request.schema.v0.1.json",
  "title": "SAEE Local HTTP Capability Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "capability_id", "operation", "payload"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^request:[A-Za-z0-9._:-]{1,120}$"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "payload": {"type": "object", "maxProperties": 32}
  }
}

