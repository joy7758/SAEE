{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://redcrag.cn/schemas/saee-internal-agent-pilot-observation.schema.v1.0.json",
  "title":"SAEE Internal Agent Pilot Observation v1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["observation_version","observation_id","run_id","agent_type","scenario","task","observed_actions","tool_usage","state_changes","authorization_evidence","reliability_findings","evidence_findings","recommendation","limitations","truth_boundary"],
  "properties":{
    "observation_version":{"const":"1.0"},
    "observation_id":{"type":"string","pattern":"^saee:internal-pilot-observation:00[1-3]$"},
    "run_id":{"type":"string","pattern":"^saee:internal-pilot-run:00[1-3]$"},
    "agent_type":{"enum":["coding_agent","research_agent","automation_agent"]},
    "scenario":{"enum":["CODE_CHANGE_WORKFLOW","RESEARCH_WORKFLOW","AUTOMATION_WORKFLOW"]},
    "task":{"type":"object","additionalProperties":false,"required":["task_id","objective","status"],"properties":{"task_id":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},"status":{"enum":["COMPLETED","PARTIAL","FAILED"]}}},
    "observed_actions":{"type":"array","minItems":3,"items":{"type":"string","minLength":1}},
    "tool_usage":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["tool","purpose","outcome","external_side_effect"],"properties":{"tool":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"outcome":{"enum":["PASS","RECOVERED","FAIL"]},"external_side_effect":{"const":false}}}},
    "state_changes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "authorization_evidence":{"$ref":"#/$defs/authorization"},
    "reliability_findings":{"type":"object","additionalProperties":false,"required":["status","canonical_evaluator_ref","evaluation_mode","projection_run_ref","reason_codes","task_success_established"],"properties":{"status":{"enum":["OBSERVED_PASS","OBSERVED_PARTIAL","OBSERVED_FAIL"]},"canonical_evaluator_ref":{"const":"saee_backend/services/agent_run_capability.py"},"evaluation_mode":{"const":"FIXED_INTERNAL_PROJECTION_NOT_DIRECT_CODEX_ASSESSMENT"},"projection_run_ref":{"const":"rehearsal-run:baseline-metadata-inspection"},"reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"task_success_established":{"const":false}}},
    "evidence_findings":{"type":"object","additionalProperties":false,"required":["claim_type","result","canonical_evaluator_ref","missing_requirements","accountability_claim_established"],"properties":{"claim_type":{"const":"AUTHORIZED_AGENT_ACTION"},"result":{"enum":["PASS","FAIL"]},"canonical_evaluator_ref":{"const":"saee_backend/services/evidence_adequacy.py"},"missing_requirements":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"accountability_claim_established":{"const":false}}},
    "recommendation":{"enum":["CONTINUE","REPLAN","HUMAN_REVIEW_REQUIRED","STOP"]},
    "limitations":{"type":"array","minItems":3,"items":{"type":"string","minLength":1}},
    "truth_boundary":{"$ref":"#/$defs/truth"}
  },
  "$defs":{
    "authorization":{"type":"object","additionalProperties":false,"required":["action_id","agent_id","requested_scope","timestamp","decision_id","decision","authority_scope","valid_from","valid_until"],"properties":{"action_id":{"type":"string","minLength":1},"agent_id":{"const":"agent:codex-current-session"},"requested_scope":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},"decision_id":{"type":"string","minLength":1},"decision":{"const":"allow"},"authority_scope":{"type":"string","minLength":1},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"}}},
    "truth":{"type":"object","additionalProperties":false,"required":["real_internal_agent_execution","chain_of_thought_stored","secrets_stored","credentials_stored","private_model_state_stored","external_validation","customer_data","production_execution","external_world_actions","adoption_validated","production_ready"],"properties":{"real_internal_agent_execution":{"const":true},"chain_of_thought_stored":{"const":false},"secrets_stored":{"const":false},"credentials_stored":{"const":false},"private_model_state_stored":{"const":false},"external_validation":{"const":false},"customer_data":{"const":false},"production_execution":{"const":false},"external_world_actions":{"const":false},"adoption_validated":{"const":false},"production_ready":{"const":false}}}
  }
}
