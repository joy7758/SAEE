{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/saee/trait.schema.json",
  "title": "SAEE Trait",
  "type": "object",
  "required": ["id", "name", "source_type", "abstraction_level", "description"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": ["paper", "repository", "market_signal", "user_feedback", "failure_case", "internal_experiment"]
    },
    "source_reference": {"type": "string"},
    "abstraction_level": {
      "type": "string",
      "enum": ["principle", "pattern", "interface", "metric", "workflow", "risk"]
    },
    "copied_code": {"type": "boolean", "const": false},
    "license_notes": {"type": "string"},
    "safety_notes": {"type": "string"}
  }
}

