{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-internal-reliability-methodology-review.schema.v1.0.json",
  "title": "SAEE Internal Reliability Methodology Review v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_version", "review_id", "benchmark_id", "review_status", "extended_benchmark_allowed", "new_model_runs", "findings", "corrections", "phase7_2_conditions", "truth_boundary"],
  "properties": {
    "review_version": {"const": "1.0"},
    "review_id": {"const": "saee:methodology-review:internal-reliability:v1.0"},
    "benchmark_id": {"const": "saee-internal-reliability-v1.0"},
    "review_status": {"const": "PASS_WITH_LIMITATIONS_TO_PHASE7_2"},
    "extended_benchmark_allowed": {"const": true},
    "new_model_runs": {"const": 0},
    "findings": {"type": "array", "minItems": 9, "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "area", "status", "finding", "evidence_refs"], "properties": {"finding_id": {"type": "string", "pattern": "^MR-[0-9]{3}$"}, "area": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FIXED", "LIMITATION"]}, "finding": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "corrections": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["correction_id", "description", "applied", "model_rerun_required"], "properties": {"correction_id": {"type": "string"}, "description": {"type": "string"}, "applied": {"const": true}, "model_rerun_required": {"const": false}}}},
    "phase7_2_conditions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "truth_boundary": {"type": "object", "additionalProperties": false, "required": ["benchmark_rerun", "overall_score", "ranking_generated", "certification", "production_ready", "external_validation_completed"], "properties": {"benchmark_rerun": {"const": false}, "overall_score": {"const": false}, "ranking_generated": {"const": false}, "certification": {"const": false}, "production_ready": {"const": false}, "external_validation_completed": {"const": false}}}
  }
}
