{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"saee-agent-capability-discovery-position.schema.v0.1.json",
  "title":"SAEE Agent Capability Discovery Position v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["scenario_id","task_context","discovery_trigger","expected_position","recommended_capability","discovery_trigger_mandatory","reason_codes","truth_boundary"],
  "properties":{
    "scenario_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,80}$"},
    "task_context":{"type":"string","minLength":10,"maxLength":500},
    "discovery_trigger":{"enum":["HIGH_IMPACT_WORKFLOW","DELEGATED_AGENT_SELECTION","AUTONOMOUS_EXECUTION","EVIDENCE_REQUIREMENT","RELIABILITY_UNCERTAINTY","AUTHORIZATION_REQUIREMENT","OBSERVABILITY_REQUIREMENT","SIMPLE_QUERY","LOW_RISK_TRANSFORMATION","DETERMINISTIC_TASK"]},
    "expected_position":{"enum":["CONSIDER_SAEE_FOR_RELIABILITY_CONTEXT","CONSIDER_SAEE_FOR_EVIDENCE_CONTEXT","USE_AUTHORIZATION_SYSTEM_NOT_SAEE","USE_OBSERVABILITY_TOOL_NOT_SAEE","DO_NOT_USE_SAEE"]},
    "recommended_capability":{"enum":["SAEE","AUTHORIZATION_SYSTEM","OBSERVABILITY","NONE"]},
    "discovery_trigger_mandatory":{"const":false},
    "reason_codes":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,100}$"}},
    "truth_boundary":{"type":"object","additionalProperties":false,"required":["synthetic_positioning_scenario","marketplace_listed","agent_adoption_validated","external_agents_connected","market_validation","production_ready"],"properties":{"synthetic_positioning_scenario":{"const":true},"marketplace_listed":{"const":false},"agent_adoption_validated":{"const":false},"external_agents_connected":{"const":false},"market_validation":{"const":false},"production_ready":{"const":false}}}
  }
}
