{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://redcrag.cn/schemas/saee-internal-agent-pilot-execution-manifest.schema.v1.0.json",
  "title":"SAEE Internal Agent Pilot Execution Manifest v1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["manifest_version","pilot_id","runs","limitations","truth_boundary"],
  "properties":{
    "manifest_version":{"const":"1.0"},
    "pilot_id":{"const":"saee.internal-agent-pilot.execution.v1"},
    "runs":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/run"}},
    "limitations":{"type":"array","minItems":3,"items":{"type":"string","minLength":1}},
    "truth_boundary":{"$ref":"#/$defs/truth"}
  },
  "$defs":{
    "run":{
      "type":"object","additionalProperties":false,
      "required":["run_id","agent_type","agent_runtime","model_provider","model_reference","task_type","scenario","execution_environment","tool_scope","data_scope","limitations"],
      "properties":{
        "run_id":{"type":"string","pattern":"^saee:internal-pilot-run:00[1-3]$"},
        "agent_type":{"enum":["coding_agent","research_agent","automation_agent"]},
        "agent_runtime":{"const":"codex_desktop_current_session"},
        "model_provider":{"const":"openai_codex"},
        "model_reference":{"const":"codex-current-session-model-id-not-recorded"},
        "task_type":{"type":"string","minLength":1},
        "scenario":{"enum":["CODE_CHANGE_WORKFLOW","RESEARCH_WORKFLOW","AUTOMATION_WORKFLOW"]},
        "execution_environment":{"const":"LOCAL_CONTROLLED"},
        "tool_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["read_local_files","apply_bounded_patch","run_offline_validator","run_local_test","compute_digest"]}},
        "data_scope":{"const":"SYNTHETIC_OR_PUBLIC_ONLY"},
        "limitations":{"type":"array","minItems":2,"items":{"type":"string","minLength":1}}
      }
    },
    "truth":{
      "type":"object","additionalProperties":false,
      "required":["internal_agent_pilot","pilot_executed","real_internal_execution","external_validation","customer_data","production_execution","external_world_actions","adoption_validated","production_ready"],
      "properties":{
        "internal_agent_pilot":{"const":true},"pilot_executed":{"const":true},"real_internal_execution":{"const":true},
        "external_validation":{"const":false},"customer_data":{"const":false},"production_execution":{"const":false},
        "external_world_actions":{"const":false},"adoption_validated":{"const":false},"production_ready":{"const":false}
      }
    }
  }
}
