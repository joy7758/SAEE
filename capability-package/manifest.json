{
  "manifest_version": "1.0.0",
  "package_id": "saee.agent-reliability",
  "package_name": "SAEE Capability Service Package",
  "package_stage": "local_contract_alpha",
  "default_language": "zh-CN",
  "files": {
    "capability_card": "capability-card.json",
    "openapi_contract": "openapi.yaml",
    "mcp_tool_contract": "mcp-tool.json",
    "discovery_document": ".well-known/saee-capability.json",
