      "status": "contract_only",
      "contract_ref": "openapi.yaml#/paths/~1capabilities~1rehearse-agent/post",
      "mcp_ref": "mcp-tool.json#/tools/2"
    }
  ],
  "local_runtime": {
    "status": "local_alpha",
    "service_ref": "../saee_backend/services/capability_runtime/capability_invocation.py",
