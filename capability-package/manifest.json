    "quick_understanding_reference": "../docs/public/SAEE_AGENT_QUICK_UNDERSTANDING.md",
    "publicly_deployed": false,
    "public_api": false,
    "public_service": false,
    "production_ready": false
  },
  "public_capability_surface_reference": "../agent-interface/public/saee-public-capability-surface.v0.1.json",
  "alpha_release_reference": "../agent-interface/release/saee-alpha-release-manifest.v0.1.json",
  "truth_consistency_validation_reference": "../agent-interface/validation/saee-capability-truth-consistency-result.v0.1.json",
  "truth_boundary": {
    "published": false,
    "local_runtime_available": true,
