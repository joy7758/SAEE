    "local_stdio_mcp_adapter_available": true,
    "local_http_adapter_available": true,
    "network_api_available": false,
    "public_service": false,
    "standard_mcp_transport": false
  },
  "validation": {
    "command": "python3 scripts/saee_capability_service_package_smoke.py",
    "offline": true,
    "deterministic": true,
    "external_dependencies_required": false
  },
  "integration_examples": {
    "status": "local_examples_alpha",
    "reference": "../agent-interface/integration/saee-agent-ecosystem-integration.v0.1.json",
    "examples_root": "../examples/agent-integrations/",
