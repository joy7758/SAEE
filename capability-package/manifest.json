    "response_schema_ref": "../schemas/saee-capability-invocation-response.schema.v0.1.json",
    "receipt_schema_ref": "../schemas/saee-capability-invocation-receipt.schema.v0.1.json",
    "mcp_adapter_ref": "../agent-interface/mcp/saee-capability-mcp-adapter.v0.1.json",
    "mcp_stdio_config_ref": "../agent-interface/mcp/saee-capability-mcp-stdio-config.v0.1.json",
    "http_adapter_ref": "../agent-interface/http/saee-capability-http-adapter.v0.1.json",
