{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Pilot Dataset Evidence Bundle Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["saee_evidence_bundle_record_v0_1", "schema_version", "episode_id", "evidence_bundle_id", "task_id", "trace_refs", "resource_receipts", "authorization_records", "human_oversight_records", "execution_effects", "causal_relationships", "limitations"],
  "properties": {
    "saee_evidence_bundle_record_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "episode_id": {"$ref": "#/$defs/id"},
    "evidence_bundle_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "trace_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "resource_receipts": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "authorization_records": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/authorization"}},
    "human_oversight_records": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/oversight"}},
    "execution_effects": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/effect"}},
    "causal_relationships": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/relationship"}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "policy_decision_ref", "action_ref", "decision", "scope", "valid_from", "valid_until"],
      "properties": {
        "authorization_id": {"$ref": "#/$defs/id"}, "policy_decision_ref": {"$ref": "#/$defs/id"}, "action_ref": {"$ref": "#/$defs/id"},
        "decision": {"enum": ["allow", "deny"]}, "scope": {"$ref": "#/$defs/id"},
        "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "oversight": {
      "type": "object", "additionalProperties": false,
      "required": ["oversight_id", "annotator_safe_identity_hash", "action_ref", "decision", "approved_scope", "timestamp"],
      "properties": {
        "oversight_id": {"$ref": "#/$defs/id"}, "annotator_safe_identity_hash": {"$ref": "#/$defs/digest"}, "action_ref": {"$ref": "#/$defs/id"},
        "decision": {"enum": ["approved", "denied", "not_applicable"]}, "approved_scope": {"$ref": "#/$defs/id"}, "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_id", "action_ref", "status", "sandbox_ref", "effect_digest"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/id"}, "action_ref": {"$ref": "#/$defs/id"}, "status": {"enum": ["observed_effect", "denied_no_effect", "unknown"]},
        "sandbox_ref": {"$ref": "#/$defs/id"}, "effect_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_id", "relationship_type", "source_ref", "target_ref", "declared_status"],
      "properties": {
        "relationship_id": {"$ref": "#/$defs/id"},
        "relationship_type": {"enum": ["trace_to_action", "action_to_authorization", "action_to_oversight", "resource_to_receipt", "action_to_effect", "resource_to_effect"]},
        "source_ref": {"$ref": "#/$defs/id"}, "target_ref": {"$ref": "#/$defs/id"},
        "declared_status": {"enum": ["declared_valid", "declared_invalid", "unverified"]}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

