  "required_inputs": [
    {"input_id": "task_description", "purpose": "bound the task and allowed behavior", "required_fields": ["task_id", "objective", "allowed_actions", "forbidden_actions", "expected_outcome"], "sensitivity": "low_to_context_dependent", "retention": "version and delete under the approved schedule"},
    {"input_id": "agent_action_trace", "purpose": "record observed action sequence", "required_fields": ["agent_id", "action_id", "event_type", "timestamp"], "sensitivity": "medium", "retention": "prefer summaries and separate raw payloads"},
    {"input_id": "resource_metadata", "purpose": "distinguish requested and resolved resources", "required_fields": ["requested_resource", "resolved_uri", "publisher_identity", "content_digest"], "sensitivity": "medium", "retention": "redact private locations and retain provenance manifest"},
    {"input_id": "authorization_records", "purpose": "evaluate action authorization scope", "required_fields": ["policy_decision_ref", "decision", "authority_scope", "valid_at", "action_ref"], "sensitivity": "medium_high", "retention": "restrict access and minimize disclosed policy content"},
    {"input_id": "human_approval_records", "purpose": "evaluate human oversight claims", "required_fields": ["human_identity", "approval_context", "approved_scope", "approval_timestamp"], "sensitivity": "high", "retention": "pseudonymize and use the shortest approved period"},
    {"input_id": "execution_outcomes", "purpose": "bind effect or denial to the controlled action", "required_fields": ["execution_effect_ref", "status", "sandbox_ref", "causal_binding"], "sensitivity": "medium", "retention": "separate sensitive output from structured result"},
    {"input_id": "evidence_package", "purpose": "provide claim-specific evaluator input", "required_fields": ["claim_type", "profile_ref", "evidence_objects", "relationships", "manifest"], "sensitivity": "inherits_components", "retention": "retain version, digest, access and deletion records"}
