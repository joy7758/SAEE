{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Observation Replay Contract v0.1",
  "description": "A strict local synthetic governance contract for reconstructing observation context. It does not execute an Agent, verify consent or provenance, establish Evidence, or authorize deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_observation_replay_contract_v0_1",
    "schema_version",
    "replay_id",
    "created_at",
    "replay_status",
    "source_envelope_refs",
    "purpose",
    "consent_ref",
    "consent_status",
    "data_use_permission_ref",
    "data_use_permission_status",
    "content_boundary",
    "transformation_log",
    "environment_manifest_ref",
    "replay_window",
    "operator_ref",
    "stop_authority_ref",
    "retention_ref",
    "deletion_ref",
    "execution_policy",
    "truth_boundary"
  ],
  "properties": {
    "saee_observation_replay_contract_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "replay_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "replay_status": {"const": "local_synthetic_contract_only"},
    "source_envelope_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/source_envelope_ref"}
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_case", "allowed_scope", "prohibited_scope"],
      "properties": {
        "use_case": {"type": "string", "minLength": 1, "maxLength": 300},
        "allowed_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "prohibited_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "consent_ref": {"$ref": "#/$defs/id"},
    "consent_status": {"enum": ["synthetic_declared_only", "externally_recorded_not_verified"]},
    "data_use_permission_ref": {"$ref": "#/$defs/id"},
    "data_use_permission_status": {"enum": ["synthetic_declared_only", "externally_recorded_not_verified"]},
    "content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_behavior_only",
        "hidden_reasoning_excluded",
        "private_chain_of_thought_excluded",
        "internal_model_state_excluded",
        "raw_prompt_excluded",
        "raw_output_excluded",
        "boundary_basis",
        "independently_verified"
      ],
      "properties": {
        "observable_behavior_only": {"const": true},
        "hidden_reasoning_excluded": {"const": true},
        "private_chain_of_thought_excluded": {"const": true},
        "internal_model_state_excluded": {"const": true},
        "raw_prompt_excluded": {"const": true},
        "raw_output_excluded": {"const": true},
        "boundary_basis": {"enum": ["synthetic_declaration", "external_attestation_not_verified"]},
        "independently_verified": {"const": false}
      }
    },
    "transformation_log": {"$ref": "#/$defs/transformation_log"},
    "environment_manifest_ref": {"$ref": "#/$defs/id"},
    "replay_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"}
      }
    },
    "operator_ref": {"$ref": "#/$defs/id"},
    "stop_authority_ref": {"$ref": "#/$defs/id"},
    "retention_ref": {"$ref": "#/$defs/id"},
    "deletion_ref": {"$ref": "#/$defs/id"},
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_mode",
        "manual_start_required",
        "automatic_replay_allowed",
        "agent_execution_allowed",
        "tool_execution_allowed",
        "network_access_allowed",
        "deployment_action_allowed"
      ],
      "properties": {
        "replay_mode": {"const": "metadata_reconstruction_only"},
        "manual_start_required": {"const": true},
        "automatic_replay_allowed": {"const": false},
        "agent_execution_allowed": {"const": false},
        "tool_execution_allowed": {"const": false},
        "network_access_allowed": {"const": false},
        "deployment_action_allowed": {"const": false}
      }
    },
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_only",
        "replay_executed",
        "source_envelopes_authenticity_verified",
        "consent_verified",
        "data_use_permission_verified",
        "transformation_provenance_verified",
        "cognitive_boundary_verified",
        "observation_established_as_evidence",
        "replay_authorizes_execution",
        "deployment_authorized",
        "automatic_execution",
        "real_agent_executed",
        "customer_data_processed",
        "external_validation_completed",
        "customer_validated",
        "production_ready"
      ],
      "properties": {
        "contract_only": {"const": true},
        "replay_executed": {"const": false},
        "source_envelopes_authenticity_verified": {"const": false},
        "consent_verified": {"const": false},
        "data_use_permission_verified": {"const": false},
        "transformation_provenance_verified": {"const": false},
        "cognitive_boundary_verified": {"const": false},
        "observation_established_as_evidence": {"const": false},
        "replay_authorizes_execution": {"const": false},
        "deployment_authorized": {"const": false},
        "automatic_execution": {"const": false},
        "real_agent_executed": {"const": false},
        "customer_data_processed": {"const": false},
        "external_validation_completed": {"const": false},
        "customer_validated": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_envelope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "envelope_ref",
        "digest_algorithm",
        "envelope_digest",
        "authenticity_verified"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"},
        "envelope_ref": {
          "type": "string",
          "pattern": "^agent-interface/architecture/examples/observation/[A-Za-z0-9._-]+\\.json$"
        },
        "digest_algorithm": {"const": "sha256"},
        "envelope_digest": {"$ref": "#/$defs/digest"},
        "authenticity_verified": {"const": false}
      }
    },
    "transformation_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformation_id",
        "method",
        "transformation_applied",
        "redaction_provenance_ref",
        "provenance_ref",
        "raw_content_retained",
        "hidden_reasoning_retained",
        "provenance_verified"
      ],
      "properties": {
        "transformation_id": {"$ref": "#/$defs/id"},
        "method": {"enum": ["none_synthetic_source", "metadata_only_redaction", "summary_only_projection"]},
        "transformation_applied": {"type": "boolean"},
        "redaction_provenance_ref": {"$ref": "#/$defs/id"},
        "provenance_ref": {"$ref": "#/$defs/id"},
        "raw_content_retained": {"const": false},
        "hidden_reasoning_retained": {"const": false},
        "provenance_verified": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "none_synthetic_source"}}, "required": ["method"]},
          "then": {"properties": {"transformation_applied": {"const": false}}},
          "else": {"properties": {"transformation_applied": {"const": true}}}
        }
      ]
    }
  }
}
