{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Synthetic External Observation Input v0.1",
  "description": "A strict local synthetic, observable-summary-only input for the Phase 2B receive-only Observation Adapter prototype.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_synthetic_external_observation_v0_1",
    "schema_version",
    "observation_id",
    "trace_id",
    "created_at",
    "adapter_id",
    "runtime_ref",
    "authorization_ref",
    "authorization_scope",
    "retention_ref",
    "deletion_ref",
    "events",
    "content_boundary"
  ],
  "properties": {
    "saee_synthetic_external_observation_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "observation_id": {"$ref": "#/$defs/id"},
    "trace_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "adapter_id": {"const": "adapter:saee-local-synthetic-observation-v0.1"},
    "runtime_ref": {"$ref": "#/$defs/id"},
    "authorization_ref": {"$ref": "#/$defs/id"},
    "authorization_scope": {"type": "string", "minLength": 1, "maxLength": 240},
    "retention_ref": {"$ref": "#/$defs/id"},
    "deletion_ref": {"$ref": "#/$defs/id"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/event"}
    },
    "content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_behavior_summary_only",
        "raw_prompt_present",
        "raw_output_present",
        "hidden_reasoning_present",
        "private_chain_of_thought_present",
        "internal_model_state_present",
        "customer_data_present"
      ],
      "properties": {
        "observable_behavior_summary_only": {"const": true},
        "raw_prompt_present": {"const": false},
        "raw_output_present": {"const": false},
        "hidden_reasoning_present": {"const": false},
        "private_chain_of_thought_present": {"const": false},
        "internal_model_state_present": {"const": false},
        "customer_data_present": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "timestamp",
        "event_type",
        "observable_behavior_summary"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "parent_event_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "timestamp": {"type": "string", "format": "date-time"},
        "event_type": {
          "enum": [
            "agent_output",
            "runtime_state",
            "memory_change",
            "state_transition",
            "tool_call",
            "tool_result",
            "failure_signal"
          ]
        },
        "observable_behavior_summary": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
