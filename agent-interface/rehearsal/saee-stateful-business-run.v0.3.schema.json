{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Stateful Synthetic Business Rehearsal Run v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["saee_stateful_business_run_v0_3", "schema_version", "run_id", "scenario_ref", "scenario_digest", "grading_profile_ref", "grading_profile_digest", "provider", "initial_state", "state_transitions", "final_state", "trace", "agent_submission", "grading", "evidence_export", "limitations", "truth_boundary"],
  "properties": {
    "saee_stateful_business_run_v0_3": {"const": true},
    "schema_version": {"const": "0.3.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "scenario_ref": {"type": "string", "pattern": "^agent-interface/rehearsal/stateful-scenarios/[A-Za-z0-9._-]+\\.json$"},
    "scenario_digest": {"$ref": "#/$defs/digest"},
    "grading_profile_ref": {"type": "string", "pattern": "^agent-interface/rehearsal/stateful-grading-profiles/[A-Za-z0-9._-]+\\.json$"},
    "grading_profile_digest": {"$ref": "#/$defs/digest"},
    "provider": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "adapter_id", "provider_rounds", "provider_response_digests", "real_reasoning_model_called", "credential_source"], "properties": {
      "provider": {"const": "baidu_qianfan"},
      "model": {"const": "ernie-4.5-turbo-128k"},
      "adapter_id": {"const": "adapter:qianfan-stateful-business-v0.3"},
      "provider_rounds": {"type": "integer", "minimum": 1, "maximum": 8},
      "provider_response_digests": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/digest"}},
      "real_reasoning_model_called": {"type": "boolean"},
      "credential_source": {"const": "environment_variable_not_recorded"}
    }},
    "initial_state": {"$ref": "#/$defs/state"},
    "state_transitions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/transition"}},
    "final_state": {"$ref": "#/$defs/state"},
    "trace": {"type": "object", "additionalProperties": false, "required": ["trace_id", "events", "trace_digest"], "properties": {
      "trace_id": {"$ref": "#/$defs/id"},
      "events": {"type": "array", "minItems": 6, "maxItems": 50, "items": {"$ref": "#/$defs/event"}},
      "trace_digest": {"$ref": "#/$defs/digest"}
    }},
    "agent_submission": {"type": "object", "additionalProperties": false, "required": ["disposition", "summary", "evidence_labels", "recommended_next_action"], "properties": {
      "disposition": {"enum": ["completed", "abstained", "refused", "human_review_required"]},
      "summary": {"type": "string", "minLength": 1, "maxLength": 600},
      "evidence_labels": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
      "recommended_next_action": {"enum": ["continue_synthetic_workflow", "stop_and_collect_evidence", "human_review"]}
    }},
    "grading": {"type": "object", "additionalProperties": false, "required": ["assessment", "reason_codes", "observed_tool_calls", "expected_disposition", "grading_profile_hidden_from_agent", "agent_prompt_digest", "grading_profile_digest"], "properties": {
      "assessment": {"enum": ["MATCHED_PROFILE", "DID_NOT_MATCH_PROFILE"]},
      "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 140}},
      "observed_tool_calls": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"enum": ["read_synthetic_change_record", "run_synthetic_test_suite", "inspect_synthetic_release_state", "request_synthetic_deployment", "submit_stateful_rehearsal_result"]}},
      "expected_disposition": {"enum": ["completed", "abstained", "refused", "human_review_required"]},
      "grading_profile_hidden_from_agent": {"const": true},
      "agent_prompt_digest": {"$ref": "#/$defs/digest"},
      "grading_profile_digest": {"$ref": "#/$defs/digest"}
    }},
    "evidence_export": {"type": "object", "additionalProperties": false, "required": ["evidence_export_id", "trace_digest", "initial_state_digest", "final_state_digest", "transition_chain_digest", "provider_response_digests", "grading_profile_digest", "evidence_established", "readiness_established"], "properties": {
      "evidence_export_id": {"$ref": "#/$defs/id"},
      "trace_digest": {"$ref": "#/$defs/digest"},
      "initial_state_digest": {"$ref": "#/$defs/digest"},
      "final_state_digest": {"$ref": "#/$defs/digest"},
      "transition_chain_digest": {"$ref": "#/$defs/digest"},
      "provider_response_digests": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/digest"}},
      "grading_profile_digest": {"$ref": "#/$defs/digest"},
      "evidence_established": {"const": false},
      "readiness_established": {"const": false}
    }},
    "limitations": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "truth_boundary": {"type": "object", "additionalProperties": false, "required": ["stateful_synthetic_world_executed", "real_reasoning_model_called", "real_customer_agent_executed", "external_world_actions", "customer_data_used", "risk_probability_measured", "deployment_authorized", "production_ready"], "properties": {
      "stateful_synthetic_world_executed": {"const": true},
      "real_reasoning_model_called": {"type": "boolean"},
      "real_customer_agent_executed": {"const": false},
      "external_world_actions": {"const": 0},
      "customer_data_used": {"const": false},
      "risk_probability_measured": {"const": false},
      "deployment_authorized": {"const": false},
      "production_ready": {"const": false}
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 220, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,219}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"type": "object", "additionalProperties": false, "required": ["revision", "change_record_read", "change_risk", "test_status", "release_state_inspected", "rollback_plan_present", "human_approval_present", "deployment_requested"], "properties": {
      "revision": {"type": "integer", "minimum": 0, "maximum": 20},
      "change_record_read": {"type": "boolean"},
      "change_risk": {"enum": ["unknown", "low", "medium", "high"]},
      "test_status": {"enum": ["unknown", "passed", "failed"]},
      "release_state_inspected": {"type": "boolean"},
      "rollback_plan_present": {"type": "boolean"},
      "human_approval_present": {"type": "boolean"},
      "deployment_requested": {"type": "boolean"}
    }},
    "transition": {"type": "object", "additionalProperties": false, "required": ["transition_id", "tool_name", "revision_before", "revision_after", "state_before_digest", "state_after_digest", "state_changed", "external_effect"], "properties": {
      "transition_id": {"$ref": "#/$defs/id"},
      "tool_name": {"enum": ["read_synthetic_change_record", "run_synthetic_test_suite", "inspect_synthetic_release_state", "request_synthetic_deployment"]},
      "revision_before": {"type": "integer", "minimum": 0, "maximum": 20},
      "revision_after": {"type": "integer", "minimum": 0, "maximum": 20},
      "state_before_digest": {"$ref": "#/$defs/digest"},
      "state_after_digest": {"$ref": "#/$defs/digest"},
      "state_changed": {"type": "boolean"},
      "external_effect": {"const": false}
    }},
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "sequence", "timestamp", "event_type", "summary", "summary_digest"], "properties": {
      "event_id": {"$ref": "#/$defs/id"},
      "sequence": {"type": "integer", "minimum": 0, "maximum": 60},
      "timestamp": {"type": "string", "format": "date-time"},
      "event_type": {"enum": ["TASK_RECEIVED", "PROVIDER_REQUEST", "PROVIDER_RESPONSE", "TOOL_CALL", "TOOL_RESULT", "STATE_TRANSITION", "AGENT_SUBMISSION", "GRADING_RESULT"]},
      "summary": {"type": "string", "minLength": 1, "maxLength": 600},
      "summary_digest": {"$ref": "#/$defs/digest"},
      "tool_name": {"enum": ["read_synthetic_change_record", "run_synthetic_test_suite", "inspect_synthetic_release_state", "request_synthetic_deployment", "submit_stateful_rehearsal_result"]},
      "payload_digest": {"$ref": "#/$defs/digest"}
    }}
  }
}
