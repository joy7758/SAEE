{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Agent Rehearsal Scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["saee_agent_rehearsal_scenario_v0_1", "schema_version", "scenario_id", "scenario_category", "task", "agent_adapter", "sandbox", "policy", "environment", "expected_outcome", "truth_boundary"],
  "properties": {
    "saee_agent_rehearsal_scenario_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "scenario_id": {"$ref": "#/$defs/id"},
    "scenario_category": {"enum": ["baseline", "context_drift", "tool_failure", "instruction_conflict", "adversarial_input"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "objective", "requested_scope", "created_at"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 400},
        "requested_scope": {"$ref": "#/$defs/id"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "agent_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "adapter_type", "agent_id", "synthetic"],
      "properties": {
        "adapter_id": {"const": "adapter:saee-fixed-policy-agent-v0.1"},
        "adapter_version": {"const": "0.1.0"},
        "adapter_type": {"const": "fixed_internal_policy_agent"},
        "agent_id": {"$ref": "#/$defs/id"},
        "synthetic": {"const": true}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox_id", "synthetic", "network_allowed", "subprocess_allowed", "filesystem_write_allowed", "allowed_tools", "max_steps"],
      "properties": {
        "sandbox_id": {"$ref": "#/$defs/id"},
        "synthetic": {"const": true},
        "network_allowed": {"const": false},
        "subprocess_allowed": {"const": false},
        "filesystem_write_allowed": {"const": false},
        "allowed_tools": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["synthetic_metadata_reader", "synthetic_context_reader", "synthetic_timeout_tool", "synthetic_invalid_response_tool", "synthetic_missing_dependency_tool", "synthetic_partial_result_tool"]}},
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "allowed_scope", "forbidden_scopes", "valid_from", "valid_until", "human_stop_authority_ref"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "allowed_scope": {"$ref": "#/$defs/id"},
        "forbidden_scopes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "human_stop_authority_ref": {"$ref": "#/$defs/id"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "tool_behavior", "fixture_label", "fixture_digest"],
      "properties": {
        "environment_id": {"$ref": "#/$defs/id"},
        "tool_behavior": {"enum": ["success", "timeout", "invalid_response", "missing_dependency", "partial_result", "stale_context", "state_mismatch", "forbidden_request", "adversarial_request"]},
        "fixture_label": {"type": "string", "minLength": 1, "maxLength": 120},
        "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_status", "agent_disposition", "policy_decision", "external_effect_expected"],
      "properties": {
        "run_status": {"const": "COMPLETED"},
        "agent_disposition": {"enum": ["completed", "abstained", "refused"]},
        "policy_decision": {"enum": ["allow", "deny"]},
        "external_effect_expected": {"const": false}
      }
    },
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_scenario", "external_agent", "customer_data", "network", "external_execution", "deployment_authorized", "production_ready"],
      "properties": {
        "synthetic_scenario": {"const": true},
        "external_agent": {"const": false},
        "customer_data": {"const": false},
        "network": {"const": false},
        "external_execution": {"const": false},
        "deployment_authorized": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"}
  }
}
