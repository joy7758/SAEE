{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Agent Rehearsal Run v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["saee_agent_rehearsal_run_v0_1", "schema_version", "run_id", "scenario_ref", "scenario_digest", "run_status", "agent_disposition", "policy_decision", "trace", "evidence_export", "limitations", "truth_boundary"],
  "properties": {
    "saee_agent_rehearsal_run_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "scenario_ref": {"type": "string", "pattern": "^agent-interface/(?:rehearsal/scenarios/[A-Za-z0-9._-]+\\.json|benchmarks/saee-agent-readiness-benchmark.v0.1.json#[A-Za-z0-9._:-]+)$"},
    "scenario_digest": {"$ref": "#/$defs/digest"},
    "run_status": {"const": "COMPLETED"},
    "agent_disposition": {"enum": ["completed", "abstained", "refused"]},
    "policy_decision": {"enum": ["allow", "deny"]},
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "events", "trace_digest"],
      "properties": {
        "trace_id": {"$ref": "#/$defs/id"},
        "events": {"type": "array", "minItems": 3, "maxItems": 12, "items": {"$ref": "#/$defs/event"}},
        "trace_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_export_id", "trace_ref", "trace_digest", "claim_type", "claim_candidate", "evidence_established", "adequacy_evaluated"],
      "properties": {
        "evidence_export_id": {"$ref": "#/$defs/id"},
        "trace_ref": {"$ref": "#/$defs/id"},
        "trace_digest": {"$ref": "#/$defs/digest"},
        "claim_type": {"const": "AUTHORIZED_AGENT_ACTION"},
        "claim_candidate": {"type": "object"},
        "evidence_established": {"const": false},
        "adequacy_evaluated": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_rehearsal_runtime_executed", "fixed_internal_agent_executed", "real_external_agent_executed", "external_tool_executed", "network_accessed", "subprocess_started", "customer_data_used", "evidence_established", "readiness_decision_made", "deployment_authorized", "production_ready"],
      "properties": {
        "local_rehearsal_runtime_executed": {"const": true},
        "fixed_internal_agent_executed": {"const": true},
        "real_external_agent_executed": {"const": false},
        "external_tool_executed": {"const": false},
        "network_accessed": {"const": false},
        "subprocess_started": {"const": false},
        "customer_data_used": {"const": false},
        "evidence_established": {"const": false},
        "readiness_decision_made": {"const": false},
        "deployment_authorized": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,179}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "timestamp", "event_type", "summary", "summary_digest"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 20},
        "timestamp": {"type": "string", "format": "date-time"},
        "event_type": {"enum": ["TASK_RECEIVED", "POLICY_DECISION", "TOOL_CALL", "TOOL_RESULT", "FAILURE_SIGNAL", "AGENT_OUTPUT"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 400},
        "summary_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
