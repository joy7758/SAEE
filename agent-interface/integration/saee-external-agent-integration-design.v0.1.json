    "namespace_isolation_required": true,
    "cross_tenant_access_allowed": false,
    "tenant_identity_verified": false
  },
  "secret_model": {
    "implementation_status": "requirements_only",
    "credential_isolation_required": true,
    "credential_rotation_required": true,
    "least_privilege_required": true,
    "repository_secret_storage_allowed": false,
    "credentials_stored": false,
    "secret_values_present": false
  },
  "human_control_model": {
    "human_approval_required": true,
    "human_review_bypass_allowed": false,
    "saee_can": ["EVALUATE_EVIDENCE_SUFFICIENCY", "IDENTIFY_MISSING_RELATIONSHIPS", "PRODUCE_BOUNDED_REPORT"],
