{
  "saee_external_agent_integration_design_v0_1": true,
  "design_version": "0.1",
  "design_status": "design_only",
  "documentation_ref": "docs/architecture/SAEE_EXTERNAL_AGENT_INTEGRATION_DESIGN.md",
  "architecture_flow": [
    "EXTERNAL_AGENT",
    "AGENT_CAPABILITY_DISCOVERY",
    "MCP_CAPABILITY_INTERFACE",
    "SAEE_CAPABILITY_OBJECT",
    "EVIDENCE_ADEQUACY_EVALUATION",
    "HUMAN_REVIEW_BOUNDARY"
  ],
  "identity_model": {
