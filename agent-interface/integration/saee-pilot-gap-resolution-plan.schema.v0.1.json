{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saee:integration:pilot-gap-resolution-plan:0.1",
  "title": "SAEE Pilot Gap Resolution Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gap_plan_version",
    "plan_stage",
    "readiness_status",
    "source_readiness_result_ref",
    "documentation_ref",
    "gaps",
    "dependency_order",
    "reassessment_rules",
    "gaps_closed",
    "evidence_acquired",
    "readiness_changed",
    "pilot_authorized",
    "execution_authorized",
    "external_validation_completed",
    "production_ready",
    "network_accessed",
    "external_execution"
  ],
  "properties": {
    "gap_plan_version": {"const": "0.1"},
    "plan_stage": {"const": "planning_only"},
    "readiness_status": {"const": "NOT_READY"},
    "source_readiness_result_ref": {"type": "string", "minLength": 1},
    "documentation_ref": {"type": "string", "minLength": 1},
    "gaps": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/gap"}
    },
    "dependency_order": {
      "const": ["IDENTITY", "SECURITY", "DATA", "RUNTIME", "HUMAN_GOVERNANCE", "RE_READINESS_REVIEW"]
    },
    "reassessment_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_gaps_closed_required",
        "all_artifacts_verified_required",
        "evidence_refs_required_for_future_closure",
        "independent_re_review_required",
        "reassessment_allowed",
        "go_authorized"
      ],
      "properties": {
        "all_gaps_closed_required": {"const": true},
        "all_artifacts_verified_required": {"const": true},
        "evidence_refs_required_for_future_closure": {"const": true},
        "independent_re_review_required": {"const": true},
        "reassessment_allowed": {"const": false},
        "go_authorized": {"const": false}
      }
    },
    "gaps_closed": {"const": 0},
    "evidence_acquired": {"const": false},
    "readiness_changed": {"const": false},
    "pilot_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "external_validation_completed": {"const": false},
    "production_ready": {"const": false},
    "network_accessed": {"const": false},
    "external_execution": {"const": false}
  },
  "$defs": {
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "source_blocker_ids",
        "category",
        "severity",
        "current_status",
        "owner_role",
        "required_artifact_type",
        "verification_method",
        "dependencies",
        "evidence_refs"
      ],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1, "pattern": "^GAP_[A-Z0-9_]+$"},
        "source_blocker_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "category": {"enum": ["IDENTITY", "SECURITY", "DATA", "RUNTIME", "HUMAN_GOVERNANCE"]},
        "severity": {"enum": ["CRITICAL", "HIGH"]},
        "current_status": {"const": "OPEN"},
        "owner_role": {
          "enum": [
            "IDENTITY_SECURITY_LEAD",
            "SECURITY_REVIEWER",
            "DATA_GOVERNANCE_OWNER",
            "RUNTIME_OPERATOR",
            "HUMAN_GOVERNANCE_OWNER"
          ]
        },
        "required_artifact_type": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^GAP_[A-Z0-9_]+$"}
        },
        "evidence_refs": {"type": "array", "maxItems": 0}
      }
    }
  }
}
