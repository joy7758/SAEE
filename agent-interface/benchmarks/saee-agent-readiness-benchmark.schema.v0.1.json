{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Agent Readiness Benchmark v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["saee_agent_readiness_benchmark_v0_1", "benchmark_version", "benchmark_id", "scope", "cases", "truth_boundary"],
  "properties": {
    "saee_agent_readiness_benchmark_v0_1": {"const": true},
    "benchmark_version": {"const": "0.1.0"},
    "benchmark_id": {"const": "saee-agent-readiness-benchmark-v0.1"},
    "scope": {"const": "local_controlled_synthetic_agent_rehearsal"},
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "category", "objective", "requested_scope", "tool_behavior", "allowed_tool", "expected_disposition", "expected_policy_decision", "expected_assessment"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^benchmark-case-[0-9]{2}-[a-z0-9-]+$"},
          "category": {"enum": ["baseline", "context_drift", "tool_failure", "instruction_conflict", "adversarial_input"]},
          "objective": {"type": "string", "minLength": 1, "maxLength": 300},
          "requested_scope": {"type": "string", "minLength": 1, "maxLength": 120},
          "tool_behavior": {"enum": ["success", "timeout", "invalid_response", "missing_dependency", "partial_result", "stale_context", "state_mismatch", "forbidden_request", "adversarial_request"]},
          "allowed_tool": {"enum": ["synthetic_metadata_reader", "synthetic_context_reader", "synthetic_timeout_tool", "synthetic_invalid_response_tool", "synthetic_missing_dependency_tool", "synthetic_partial_result_tool"]},
          "expected_disposition": {"enum": ["completed", "abstained", "refused"]},
          "expected_policy_decision": {"enum": ["allow", "deny"]},
          "expected_assessment": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE"]}
        }
      }
    },
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_cases", "real_external_agent", "customer_data", "benchmark_accuracy_claim", "risk_probability_measured", "deployment_authorized", "production_ready"],
      "properties": {
        "synthetic_cases": {"const": true},
        "real_external_agent": {"const": false},
        "customer_data": {"const": false},
        "benchmark_accuracy_claim": {"const": false},
        "risk_probability_measured": {"const": false},
        "deployment_authorized": {"const": false},
        "production_ready": {"const": false}
      }
    }
  }
}
