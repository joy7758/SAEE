{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-research-agent-reliability-study.schema.v0.2.json",
  "title": "SAEE Research Agent Reliability Scenario Study v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_version", "study_id", "study_complete", "scenario_id", "agents_requested", "runs_per_agent", "total_runs_requested", "total_runs_executed", "total_runs_completed", "total_contract_failed_runs", "isolated_runs", "agent_profiles", "ranking_generated", "leaderboard_generated", "winner_selected", "intelligence_score_generated", "limitations", "truth_boundary"],
  "properties": {
    "study_version": {"const": "0.2"},
    "study_id": {"const": "saee-study:research-agent-evidence-reliability:v0.2"},
    "study_complete": {"type": "boolean"},
    "scenario_id": {"const": "saee-rehearsal:research-evidence-review:v0.2"},
    "agents_requested": {"const": 3},
    "runs_per_agent": {"const": 5},
    "total_runs_requested": {"const": 15},
    "total_runs_executed": {"type": "integer", "minimum": 0, "maximum": 15},
    "total_runs_completed": {"type": "integer", "minimum": 0, "maximum": 15},
    "total_contract_failed_runs": {"type": "integer", "minimum": 0, "maximum": 15},
    "isolated_runs": {"const": true},
    "agent_profiles": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/agent"}},
    "ranking_generated": {"const": false},
    "leaderboard_generated": {"const": false},
    "winner_selected": {"const": false},
    "intelligence_score_generated": {"const": false},
    "limitations": {"$ref": "#/$defs/strings"},
    "truth_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["real_model_execution", "synthetic_environment", "external_search", "external_world_actions", "customer_data", "production_execution", "factual_truth_established", "legal_or_medical_conclusion", "ranking_generated", "reliability_probability_estimated", "external_validation", "production_ready"],
      "properties": {
        "real_model_execution": {"const": true}, "synthetic_environment": {"const": true},
        "external_search": {"const": false}, "external_world_actions": {"const": false},
        "customer_data": {"const": false}, "production_execution": {"const": false},
        "factual_truth_established": {"const": false}, "legal_or_medical_conclusion": {"const": false},
        "ranking_generated": {"const": false}, "reliability_probability_estimated": {"const": false},
        "external_validation": {"const": false}, "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "status", "unavailable_reason", "initial_state_digest", "tools_digest", "provider_rounds", "state_transitions", "observation_count", "tool_sequence", "observed_risk_signals", "agent_declared_risks", "agent_recommendation", "bounded_recommendation", "missing_evidence", "evidence_outcomes", "repeated_tool_calls", "requested_help", "replanned", "claim_boundary_passed", "citation_check_completed", "uncertainty_passed", "conflict_acknowledged", "incomplete_references_acknowledged", "claim_types", "citation_source_ids"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run:[a-z0-9_]+:[0-9]{2}$"},
        "status": {"enum": ["completed", "contract_failed", "unavailable"]},
        "unavailable_reason": {"type": ["string", "null"]},
        "initial_state_digest": {"$ref": "#/$defs/sha256"}, "tools_digest": {"$ref": "#/$defs/sha256"},
        "provider_rounds": {"type": "integer", "minimum": 0}, "state_transitions": {"type": "integer", "minimum": 0}, "observation_count": {"type": "integer", "minimum": 0},
        "tool_sequence": {"type": "array", "items": {"enum": ["evidence_search", "citation_checker", "claim_validator", "uncertainty_checker"]}},
        "observed_risk_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "agent_declared_risks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "agent_recommendation": {"type": ["string", "null"]}, "bounded_recommendation": {"type": ["string", "null"]},
        "missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_outcomes": {"type": "array", "items": {"enum": ["AUTHORIZED_AGENT_ACTION:PASS", "AUTHORIZED_AGENT_ACTION:FAIL"]}},
        "repeated_tool_calls": {"type": "integer", "minimum": 0}, "requested_help": {"type": "boolean"}, "replanned": {"type": "boolean"},
        "claim_boundary_passed": {"type": "boolean"}, "citation_check_completed": {"type": "boolean"}, "uncertainty_passed": {"type": "boolean"},
        "conflict_acknowledged": {"type": "boolean"}, "incomplete_references_acknowledged": {"type": "boolean"},
        "claim_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "citation_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_profile", "provider", "model_vendor", "model", "run_count", "completed_runs", "contract_failed_runs", "run_results", "metrics", "research_metrics", "limitations"],
      "properties": {
        "agent_profile": {"enum": ["deepseek_ark", "glm_ark", "doubao_ark"]},
        "provider": {"const": "volcengine_ark"}, "model_vendor": {"enum": ["deepseek", "zhipu", "bytedance"]},
        "model": {"type": "string", "minLength": 3}, "run_count": {"const": 5},
        "completed_runs": {"type": "integer", "minimum": 0, "maximum": 5}, "contract_failed_runs": {"type": "integer", "minimum": 0, "maximum": 5},
        "run_results": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/run"}},
        "metrics": {"type": "object", "minProperties": 5},
        "research_metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["claim_boundary_stability", "citation_behavior", "uncertainty_handling", "evidence_stability"],
          "properties": {
            "claim_boundary_stability": {"type": "object", "required": ["boundary_pass_runs", "boundary_violation_runs", "claim_type_counts"]},
            "citation_behavior": {"type": "object", "required": ["citation_checked_runs", "missing_citation_observed_runs", "complete_source_citation_runs"]},
            "uncertainty_handling": {"type": "object", "required": ["conflict_acknowledged_runs", "incomplete_references_acknowledged_runs", "uncertainty_pass_runs"]},
            "evidence_stability": {"type": "object", "required": ["adequacy_pass_runs", "adequacy_fail_runs"]}
          }
        },
        "limitations": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
