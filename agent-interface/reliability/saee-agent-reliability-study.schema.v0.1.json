{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-agent-reliability-study.schema.v0.1.json",
  "title": "SAEE Agent Reliability Study v0.1",
  "description": "同一 Agent、同一合成场景、同一环境的重复演练观察；不是总体可靠性概率或模型排名。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_version", "study_id", "study_complete", "scenario_id", "agents_requested", "runs_per_agent",
    "total_runs_requested", "total_runs_executed", "total_runs_completed", "total_contract_failed_runs", "isolated_runs", "agent_profiles", "ranking_generated",
    "leaderboard_generated", "winner_selected", "intelligence_score_generated", "limitations", "truth_boundary"
  ],
  "properties": {
    "study_version": {"const": "0.1"},
    "study_id": {"const": "saee-study:coding-agent-release-reliability:v0.1"},
    "study_complete": {"type": "boolean"},
    "scenario_id": {"const": "saee-mvp:coding-agent-release:v0.1"},
    "agents_requested": {"const": 3},
    "runs_per_agent": {"type": "integer", "minimum": 10},
    "total_runs_requested": {"type": "integer", "minimum": 30},
    "total_runs_executed": {"type": "integer", "minimum": 0},
    "total_runs_completed": {"type": "integer", "minimum": 0},
    "total_contract_failed_runs": {"type": "integer", "minimum": 0},
    "isolated_runs": {"const": true},
    "agent_profiles": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/agent_study"}
    },
    "ranking_generated": {"const": false},
    "leaderboard_generated": {"const": false},
    "winner_selected": {"const": false},
    "intelligence_score_generated": {"const": false},
    "limitations": {"$ref": "#/$defs/nonempty_strings"},
    "truth_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["real_model_execution", "synthetic_environment", "external_world_actions", "customer_data", "production_execution", "reliability_probability_estimated", "external_validation", "production_ready"],
      "properties": {
        "real_model_execution": {"const": true},
        "synthetic_environment": {"const": true},
        "external_world_actions": {"const": false},
        "customer_data": {"const": false},
        "production_execution": {"const": false},
        "reliability_probability_estimated": {"const": false},
        "external_validation": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonempty_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "run_result": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "status", "unavailable_reason", "initial_state_digest", "tools_digest", "provider_rounds", "state_transitions", "observation_count", "tool_sequence", "observed_risk_signals", "agent_declared_risks", "agent_recommendation", "bounded_recommendation", "missing_evidence", "evidence_outcomes", "repeated_tool_calls", "requested_help", "replanned"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run:[a-z0-9_]+:[0-9]{2}$"},
        "status": {"enum": ["completed", "contract_failed", "unavailable"]},
        "unavailable_reason": {"type": ["string", "null"]},
        "initial_state_digest": {"$ref": "#/$defs/sha256"},
        "tools_digest": {"$ref": "#/$defs/sha256"},
        "provider_rounds": {"type": "integer", "minimum": 0},
        "state_transitions": {"type": "integer", "minimum": 0},
        "observation_count": {"type": "integer", "minimum": 0},
        "tool_sequence": {"type": "array", "items": {"type": "string"}},
        "observed_risk_signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "agent_declared_risks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "agent_recommendation": {"type": ["string", "null"]},
        "bounded_recommendation": {"type": ["string", "null"]},
        "missing_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_outcomes": {"type": "array", "items": {"type": "string"}},
        "repeated_tool_calls": {"type": "integer", "minimum": 0},
        "requested_help": {"type": "boolean"},
        "replanned": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_consistency", "risk_detection_stability", "recommendation_stability", "evidence_stability", "recovery_behavior"],
      "properties": {
        "execution_consistency": {
          "type": "object", "additionalProperties": false,
          "required": ["completed_runs", "contract_failed_runs", "unique_tool_paths", "dominant_tool_path_runs", "observed_pattern"],
          "properties": {
            "completed_runs": {"type": "integer", "minimum": 0},
            "contract_failed_runs": {"type": "integer", "minimum": 0},
            "unique_tool_paths": {"type": "integer", "minimum": 0},
            "dominant_tool_path_runs": {"type": "integer", "minimum": 0},
            "observed_pattern": {"enum": ["no_completed_runs", "consistent_within_study", "mixed_within_study", "variable_within_study"]}
          }
        },
        "risk_detection_stability": {
          "type": "object", "additionalProperties": false,
          "required": ["test_failure_detected_runs", "approval_missing_detected_runs", "rollback_missing_detected_runs", "all_expected_risks_detected_runs"],
          "properties": {
            "test_failure_detected_runs": {"type": "integer", "minimum": 0},
            "approval_missing_detected_runs": {"type": "integer", "minimum": 0},
            "rollback_missing_detected_runs": {"type": "integer", "minimum": 0},
            "all_expected_risks_detected_runs": {"type": "integer", "minimum": 0}
          }
        },
        "recommendation_stability": {
          "type": "object", "additionalProperties": false,
          "required": ["agent_recommendation_counts", "bounded_recommendation_counts", "unique_bounded_recommendations"],
          "properties": {
            "agent_recommendation_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "bounded_recommendation_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "unique_bounded_recommendations": {"type": "integer", "minimum": 0}
          }
        },
        "evidence_stability": {
          "type": "object", "additionalProperties": false,
          "required": ["unique_evidence_outcomes", "identical_across_completed_runs", "missing_evidence_counts"],
          "properties": {
            "unique_evidence_outcomes": {"type": "integer", "minimum": 0},
            "identical_across_completed_runs": {"type": "boolean"},
            "missing_evidence_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
          }
        },
        "recovery_behavior": {
          "type": "object", "additionalProperties": false,
          "required": ["replan_runs", "help_request_runs", "repeated_tool_call_runs"],
          "properties": {
            "replan_runs": {"type": "integer", "minimum": 0},
            "help_request_runs": {"type": "integer", "minimum": 0},
            "repeated_tool_call_runs": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "agent_study": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_profile", "provider", "model_vendor", "model", "run_count", "completed_runs", "contract_failed_runs", "run_results", "metrics", "limitations"],
      "properties": {
        "agent_profile": {"enum": ["deepseek_ark", "glm_ark", "doubao_ark"]},
        "provider": {"const": "volcengine_ark"},
        "model_vendor": {"enum": ["deepseek", "zhipu", "bytedance"]},
        "model": {"type": "string", "minLength": 3},
        "run_count": {"type": "integer", "minimum": 10},
        "completed_runs": {"type": "integer", "minimum": 0},
        "contract_failed_runs": {"type": "integer", "minimum": 0},
        "run_results": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/run_result"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "limitations": {"$ref": "#/$defs/nonempty_strings"}
      }
    }
  }
}
