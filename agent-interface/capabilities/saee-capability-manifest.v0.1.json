{
  "saee_agent_native_capability_manifest_v0_1": true,
  "capability_version": "0.1",
  "capability_id": "saee-evidence-adequacy",
  "name": "SAEE Evidence Adequacy Layer",
  "category": "agent accountability evidence evaluation",
  "stage": "research_prototype",
  "identity": {
    "project": "SAEE",
    "theory_name": "Silicon-Amplified Evolutionary Ecology",
    "engineering_core": "Digital Biosphere Evolution Engine",
    "commercial_capability_surface": "SAEE Evidence Capability Layer",
    "evidence_subsystem_is_project_core": false
  },
  "description": {
    "english": "SAEE evaluates whether available evidence relationships are sufficient to support defined accountability claims for agent actions.",
    "chinese": "SAEE 评估现有证据关系是否足以支持针对智能体动作定义的责任声明。",
    "capability_description_is_capability_validation": false
  },
  "should_use": [
    {
      "rule_id": "EVALUATE_EXECUTION_EVIDENCE_SUFFICIENCY",
      "intent": "Evaluate whether declared execution evidence is sufficient for a bounded accountability claim.",
      "required_conditions": ["EVIDENCE_OBJECT_AVAILABLE", "ACCOUNTABILITY_CLAIM_DEFINED", "EVALUATION_PROFILE_SELECTED"],
      "expected_outputs": ["CLAIM_ASSESSMENT", "MISSING_REQUIREMENTS", "REASON_CODES"]
    },
    {
      "rule_id": "IDENTIFY_MISSING_EVIDENCE_RELATIONSHIPS",
      "intent": "Identify missing or inconsistent relationships among evidence objects.",
      "required_conditions": ["EVIDENCE_OBJECT_AVAILABLE", "RELATIONSHIP_REQUIREMENTS_DEFINED"],
      "expected_outputs": ["MISSING_REQUIREMENTS", "REASON_CODES", "LIMITATIONS"]
    },
    {
      "rule_id": "REVIEW_AGENT_ACCOUNTABILITY_CLAIM",
      "intent": "Review whether a claim-specific evidence package satisfies a fixed local adequacy profile.",
      "required_conditions": ["ACCOUNTABILITY_CLAIM_DEFINED", "FIXED_PROFILE_SUPPORTED"],
      "expected_outputs": ["CLAIM_ASSESSMENT", "BOUNDARY_STATEMENT"]
    },
    {
      "rule_id": "PREPARE_HUMAN_EVIDENCE_REVIEW",
      "intent": "Prepare a traceable evidence-gap summary for bounded human review.",
      "required_conditions": ["SYNTHETIC_OR_APPROVED_LOCAL_INPUT", "HUMAN_REVIEW_REMAINS_AUTHORITATIVE"],
      "expected_outputs": ["SUPPORTING_EVIDENCE_REFERENCES", "MISSING_REQUIREMENTS", "LIMITATIONS"]
    }
  ],
  "should_not_use": [
    {
      "rule_id": "NO_REAL_TIME_AUTHORIZATION_ENFORCEMENT",
      "request": "Make an allow or deny authorization decision during runtime.",
      "reason": "SAEE evaluates declared evidence relationships offline and is not an authorization enforcement system.",
      "use_instead": "IAM, policy enforcement point, authorization service, or runtime policy engine."
    },
    {
      "rule_id": "NO_MALWARE_DETECTION",
      "request": "Detect malware, malicious code, or supply-chain compromise.",
      "reason": "Evidence adequacy evaluation does not inspect or execute unknown code and is not a malware scanner.",
      "use_instead": "Malware analysis, code scanning, software composition analysis, or supply-chain security tooling."
    },
    {
      "rule_id": "NO_LEGAL_OR_COMPLIANCE_CERTIFICATION",
      "request": "Issue a legal finding, regulatory compliance conclusion, or certification.",
      "reason": "A profile result is not a legal determination, compliance certification, or security certification.",
      "use_instead": "Authorized legal, compliance, audit, or certification process."
    },
    {
      "rule_id": "NO_DEPLOYMENT_APPROVAL",
      "request": "Approve an Agent or system for production deployment.",
      "reason": "A claim-specific evidence assessment is decision support and does not grant deployment authority.",
      "use_instead": "Human-owned deployment governance and approved release process."
    },
    {
      "rule_id": "NO_RUNTIME_SAFETY_BLOCKING",
      "request": "Block unsafe behavior or stop a running Agent.",
      "reason": "SAEE does not control Agent, Tool, Memory, or runtime execution.",
      "use_instead": "Runtime guardrail, sandbox, policy engine, monitoring, or incident-response control."
    }
  ],
  "input_contract": {
    "contract_type": "logical_evidence_review_package",
    "inputs": [
      {
        "name": "observation_references",
        "required": false,
        "description": "Optional inert observation provenance references. The local tool counts them but does not fetch or use them as evidence.",
        "accepted_form": "non_executable_local_reference_set"
      },
      {
        "name": "evidence_object",
        "required": true,
        "description": "A closed local evidence package matching the selected fixed adequacy profile.",
        "accepted_form": "json_object",
        "example_refs": [
          "agent-interface/examples/evidence-adequacy/resource_authenticity_pass.json",
          "agent-interface/examples/evidence-adequacy/authorized_agent_action_pass.json"
        ]
      },
      {
        "name": "accountability_claim",
        "required": true,
        "description": "One supported claim type to evaluate.",
        "accepted_values": ["RESOURCE_AUTHENTICITY", "AUTHORIZED_AGENT_ACTION", "HUMAN_OVERSIGHT", "EXECUTION_BOUNDARY"]
      },
      {
        "name": "evaluation_profile",
        "required": true,
        "description": "One repository-controlled Evidence Adequacy Profile v0.1 matching the claim type.",
        "profile_registry_ref": "agent-interface/profiles/evidence-adequacy/"
      }
    ],
    "forbidden_input_classes": [
      "UNKNOWN_EXECUTABLE_CODE",
      "UNAPPROVED_CUSTOMER_DATA",
      "CREDENTIALS_OR_SECRETS",
      "ARBITRARY_EXTERNAL_URL",
      "DYNAMIC_PROFILE_CODE"
    ]
  },
  "output_contract": {
    "outputs": [
      {
        "name": "claim_assessment",
        "values": ["PASS", "FAIL"],
        "description": "Whether the fixed local profile requirements are satisfied; not whether the real-world claim is proven."
      },
      {
        "name": "evidence_sufficiency_status",
        "values": ["PROFILE_REQUIREMENTS_SATISFIED", "PROFILE_REQUIREMENTS_NOT_SATISFIED"],
        "description": "A bounded profile result, not a safety, legal, compliance, or deployment status."
      },
      {
        "name": "missing_requirements",
        "description": "Required fields or relationships absent from the evaluated package."
      },
      {
        "name": "reason_codes",
        "description": "Stable machine-readable reasons for failed requirements."
      },
      {
        "name": "limitations",
        "description": "Truth boundaries and claims that must not be inferred."
      },
      {
        "name": "boundary_statement",
        "description": "Explicit separation between evidence assessment and authorization, safety, compliance, legal, or deployment authority."
      }
    ],
    "existing_cli_result_ref": "docs/EVIDENCE_ADEQUACY_PROFILE.md",
    "human_readable_projection_ref": "docs/commercial/SAEE_SYNTHETIC_EVIDENCE_REVIEW_REPORT_EXAMPLE.md"
  },
  "composition_model": {
    "flow": ["OBSERVATION_LAYER", "EVIDENCE_LAYER", "GOVERNANCE_LAYER"],
    "layers": [
      {
        "layer": "OBSERVATION_LAYER",
        "provides": ["OBSERVATION_REFERENCES", "TRACE_CANDIDATES"],
        "saee_interpretation": "Observation is candidate input and does not automatically establish evidence."
      },
      {
        "layer": "EVIDENCE_LAYER",
        "provides": ["EVIDENCE_OBJECTS", "ACCOUNTABILITY_CLAIMS", "EVALUATION_PROFILES"],
        "saee_interpretation": "SAEE evaluates claim-specific evidence fields and relationships using fixed local profiles."
      },
      {
        "layer": "GOVERNANCE_LAYER",
        "consumes": ["CLAIM_ASSESSMENT", "MISSING_REQUIREMENTS", "REASON_CODES", "LIMITATIONS"],
        "saee_interpretation": "Governance may use the result as decision support but retains authorization and decision authority."
      }
    ],
    "does_not_replace": ["OBSERVABILITY", "AUTHORIZATION_SYSTEM", "POLICY_ENGINE", "SECURITY_MONITORING"],
    "automatic_governance_decision": false
  },
  "existing_local_evaluation": {
