{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-evaluate-evidence-output.v0.1.schema.json",
  "title": "SAEE Local Evidence Adequacy Tool Output v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_local_evidence_tool_result_v0_1",
    "tool_contract_version",
    "tool_result",
    "claim_assessment",
    "evidence_sufficiency_status",
    "missing_requirements",
    "failed_relationships",
    "evaluated_fields",
    "reason_codes",
    "limitations",
    "boundary_statement",
    "observation_reference_count",
    "observation_not_used_as_evidence",
    "truth_boundary"
  ],
  "properties": {
    "saee_local_evidence_tool_result_v0_1": {"const": true},
    "tool_contract_version": {"const": "0.1"},
    "tool_result": {"enum": ["SUCCESS", "REJECTED_INPUT"]},
    "claim_assessment": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE", "UNKNOWN"]},
    "evidence_sufficiency_status": {"enum": ["SUFFICIENT", "INSUFFICIENT", "UNKNOWN"]},
    "missing_requirements": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "failed_relationships": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "evaluated_fields": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "reason_codes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:TOOL|EVIDENCE)_[A-Z0-9_]+$", "maxLength": 96}
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "boundary_statement": {
      "const": "SAEE tool capability evaluates evidence adequacy. It does not authorize actions, approve deployment, certify safety or compliance, or establish a legal conclusion."
    },
    "observation_reference_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "observation_not_used_as_evidence": {"const": true},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_tool_prototype",
        "network_accessed",
        "subprocess_started",
        "external_execution",
        "persistence_performed",
        "mcp_available",
        "api_available",
        "authorization_performed",
        "deployment_authorized",
        "safety_certified",
        "legal_determination_made",
        "production_ready"
      ],
      "properties": {
        "local_tool_prototype": {"const": true},
        "network_accessed": {"const": false},
        "subprocess_started": {"const": false},
        "external_execution": {"const": false},
        "persistence_performed": {"const": false},
        "mcp_available": {"const": false},
        "api_available": {"const": false},
        "authorization_performed": {"const": false},
        "deployment_authorized": {"const": false},
        "safety_certified": {"const": false},
        "legal_determination_made": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"tool_result": {"const": "SUCCESS"}}},
      "then": {
        "properties": {
          "claim_assessment": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE"]},
          "evidence_sufficiency_status": {"enum": ["SUFFICIENT", "INSUFFICIENT"]}
        }
      }
    },
    {
      "if": {"properties": {"tool_result": {"const": "REJECTED_INPUT"}}},
      "then": {
        "properties": {
          "claim_assessment": {"const": "UNKNOWN"},
          "evidence_sufficiency_status": {"const": "UNKNOWN"},
          "reason_codes": {"minItems": 1}
        },
        "required": ["reason_codes"]
      }
    },
    {
      "if": {"properties": {"claim_assessment": {"const": "SUPPORTED"}}},
      "then": {"properties": {"evidence_sufficiency_status": {"const": "SUFFICIENT"}}}
    },
    {
      "if": {"properties": {"claim_assessment": {"const": "INSUFFICIENT_EVIDENCE"}}},
      "then": {"properties": {"evidence_sufficiency_status": {"const": "INSUFFICIENT"}}}
    },
    {
      "if": {"properties": {"claim_assessment": {"const": "UNKNOWN"}}},
      "then": {"properties": {"evidence_sufficiency_status": {"const": "UNKNOWN"}}}
    }
  ]
}
