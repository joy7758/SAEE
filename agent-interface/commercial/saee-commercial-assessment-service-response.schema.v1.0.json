{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saee-commercial-assessment-service-response.schema.v1.0.json",
  "title": "SAEE Commercial Assessment Service Response v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_version", "response_id", "request_id", "service_stage", "scope_summary", "dimension_findings", "failure_observations", "evidence_summary", "review_actions", "input_bindings", "limitations", "truth_boundary"],
  "properties": {
    "response_version": {"const": "1.0"},
    "response_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "service_stage": {"const": "local_agent_callable_validated_service"},
    "scope_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["available_runs", "selected_runs", "agent_profiles", "scenario_ids", "language"],
      "properties": {
        "available_runs": {"type": "integer", "minimum": 1},
        "selected_runs": {"type": "integer", "minimum": 1},
        "agent_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "language": {"const": "zh-CN"}
      }
    },
    "dimension_findings": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/dimension"}},
    "failure_observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["failure_type", "count", "interpretation_boundary"], "properties": {"failure_type": {"$ref": "#/$defs/id"}, "count": {"type": "integer", "minimum": 1}, "interpretation_boundary": {"type": "string", "minLength": 1}}}},
    "evidence_summary": {"type": "object", "additionalProperties": false, "required": ["supported", "insufficient", "not_assessed", "accountability_claim_established"], "properties": {"supported": {"type": "integer", "minimum": 0}, "insufficient": {"type": "integer", "minimum": 0}, "not_assessed": {"type": "integer", "minimum": 0}, "accountability_claim_established": {"const": false}}},
    "review_actions": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "input_bindings": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "sha256"], "properties": {"reference": {"$ref": "#/$defs/ref"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "limitations": {"type": "array", "minItems": 5, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "truth_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["customer_data_used", "commercial_delivery_completed", "customer_validated", "external_validation_completed", "overall_score_generated", "ranking_generated", "winner_selected", "security_certification", "compliance_determination", "legal_judgment", "deployment_authorized", "production_ready"],
      "properties": {
        "customer_data_used": {"const": false}, "commercial_delivery_completed": {"const": false}, "customer_validated": {"const": false}, "external_validation_completed": {"const": false}, "overall_score_generated": {"const": false}, "ranking_generated": {"const": false}, "winner_selected": {"const": false}, "security_certification": {"const": false}, "compliance_determination": {"const": false}, "legal_judgment": {"const": false}, "deployment_authorized": {"const": false}, "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "assessment", "observed_pass", "observed_partial", "observed_fail", "not_assessed", "statement_zh"],
      "properties": {
        "dimension": {"enum": ["task_execution_reliability", "recovery_reliability", "boundary_reliability", "evidence_reliability", "assessment_availability"]},
        "assessment": {"enum": ["OBSERVED_WITHIN_SCOPE", "MIXED_OBSERVATIONS", "INSUFFICIENT_OBSERVATION"]},
        "observed_pass": {"type": "integer", "minimum": 0}, "observed_partial": {"type": "integer", "minimum": 0}, "observed_fail": {"type": "integer", "minimum": 0}, "not_assessed": {"type": "integer", "minimum": 0}, "statement_zh": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
