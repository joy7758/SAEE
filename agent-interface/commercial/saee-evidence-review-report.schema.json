{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Evidence Adequacy Review Report v0.1",
  "description": "A strict local synthetic report prototype for communicating claim-specific evidence adequacy without certification, compliance, safety, approval, or deployment claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_evidence_review_report_v0_1",
    "report_id",
    "report_version",
    "case_reference",
    "review_scope",
    "claim_assessments",
    "evidence_summary",
    "missing_evidence",
    "boundary_statement",
    "limitations",
    "truth_boundary"
  ],
  "properties": {
    "saee_evidence_review_report_v0_1": {"const": true},
    "report_id": {"$ref": "#/$defs/id"},
    "report_version": {"const": "0.1.0"},
    "case_reference": {"$ref": "#/$defs/local_ref"},
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "scope_description", "synthetic", "customer_data_used", "compliance_review", "production_assessment"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1, "maxLength": 160},
        "scope_description": {"type": "string", "minLength": 1, "maxLength": 500},
        "synthetic": {"const": true},
        "customer_data_used": {"const": false},
        "compliance_review": {"const": false},
        "production_assessment": {"const": false}
      }
    },
    "claim_assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/claim_assessment"}
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_references", "evidence_package_references", "supporting_evidence_count", "synthetic_only"],
      "properties": {
        "observation_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/local_ref"}, "uniqueItems": true},
        "evidence_package_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/local_ref"}, "uniqueItems": true},
        "supporting_evidence_count": {"type": "integer", "minimum": 0},
        "synthetic_only": {"const": true}
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_type", "requirement", "reason_codes"],
        "properties": {
          "claim_type": {"$ref": "#/$defs/id"},
          "requirement": {"type": "string", "minLength": 1, "maxLength": 240},
          "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
        }
      }
    },
    "boundary_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "english",
        "chinese",
        "evidence_assessment_is_compliance_certification",
        "evidence_insufficient_means_system_unsafe",
        "finding_is_automated_decision",
        "synthetic_report_is_customer_deliverable",
        "production_approval"
      ],
      "properties": {
        "english": {"const": "This synthetic evidence assessment is not compliance certification, a safety determination, legal judgment, production approval, or customer deliverable."},
        "chinese": {"const": "本合成证据评估不是合规认证、安全结论、法律判断、生产批准或客户交付物。"},
        "evidence_assessment_is_compliance_certification": {"const": false},
        "evidence_insufficient_means_system_unsafe": {"const": false},
        "finding_is_automated_decision": {"const": false},
        "synthetic_report_is_customer_deliverable": {"const": false},
        "production_approval": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 30,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_report",
        "customer_data_used",
        "external_validation_completed",
        "security_certification_claimed",
        "regulatory_compliance_claimed",
        "legal_judgment_made",
        "automated_decision_made",
        "deployment_authorized",
        "customer_accepted",
        "commercial_service_delivered",
        "production_ready"
      ],
      "properties": {
        "synthetic_report": {"const": true},
        "customer_data_used": {"const": false},
        "external_validation_completed": {"const": false},
        "security_certification_claimed": {"const": false},
        "regulatory_compliance_claimed": {"const": false},
        "legal_judgment_made": {"const": false},
        "automated_decision_made": {"const": false},
        "deployment_authorized": {"const": false},
        "customer_accepted": {"const": false},
        "commercial_service_delivered": {"const": false},
        "production_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "local_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "claim_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "assessment",
        "assessment_statement",
        "assessment_statement_zh",
        "adequacy_profile_ref",
        "supporting_evidence",
        "missing_requirements",
        "reason_codes"
      ],
      "properties": {
        "claim_type": {"$ref": "#/$defs/id"},
        "assessment": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE", "UNKNOWN"]},
        "assessment_statement": {"type": "string", "minLength": 1, "maxLength": 500},
        "assessment_statement_zh": {"type": "string", "minLength": 1, "maxLength": 500},
        "adequacy_profile_ref": {"$ref": "#/$defs/local_ref"},
        "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/local_ref"}, "uniqueItems": true},
        "missing_requirements": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 240}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"assessment": {"const": "SUPPORTED"}}},
          "then": {"properties": {"missing_requirements": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"assessment": {"const": "INSUFFICIENT_EVIDENCE"}}},
          "then": {"properties": {"missing_requirements": {"minItems": 1}}}
        }
      ]
    }
  }
}
