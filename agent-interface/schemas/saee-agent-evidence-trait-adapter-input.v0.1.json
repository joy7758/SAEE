{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saee.local/schemas/saee-agent-evidence-trait-adapter-input.v0.1.json",
  "title": "SAEE Agent Evidence Trait Adapter Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_agent_evidence_trait_adapter_input_v0_1",
    "schema_version",
    "source_contract",
    "source_type",
    "source_completeness",
    "verification",
    "events",
    "truth_boundary"
  ],
  "properties": {
    "saee_agent_evidence_trait_adapter_input_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "frozen_commit"],
      "properties": {
        "name": {"const": "agent_evidence_normalized_event_traits"},
        "version": {"const": "0.2.0"},
        "frozen_commit": {"const": "e5f3ab67dfc3f0d86c1d83c2fee8d3014a5c6219"}
      }
    },
    "source_type": {"enum": ["jsonl", "langchain", "otel", "dify"]},
    "source_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_digest",
        "source_event_count",
        "normalized_event_count",
        "dropped_event_count",
        "dropped_reason_codes"
      ],
      "properties": {
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_event_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "normalized_event_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "dropped_event_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "dropped_reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "checks", "findings"],
      "properties": {
        "result": {"enum": ["PASS", "WARN", "FAIL"]},
        "checks": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"enum": ["PASS", "WARN", "FAIL", "NOT_RUN"]}
        },
        "findings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "message": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed_scope", "public_key_pem", "signature_base64"],
      "properties": {
        "signed_scope": {"const": "adapter_event_merkle_root"},
        "public_key_pem": {
          "type": "string",
          "minLength": 100,
          "maxLength": 4096,
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+-----END PUBLIC KEY-----\\n$"
        },
        "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/event"}
    },
    "truth_boundary": {"$ref": "#/$defs/input_truth_boundary"}
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_index",
        "event_id",
        "observed_at",
        "event_type",
        "actor",
        "action",
        "payload",
        "source_ref"
      ],
      "properties": {
        "event_index": {"type": "integer", "minimum": 0, "maximum": 99},
        "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "event_type": {"enum": ["agent_action", "tool_call", "tool_result", "system_event"]},
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": {"enum": ["user", "agent", "tool", "system"]},
            "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
          }
        },
        "action": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "payload": {"type": "object", "maxProperties": 16},
        "source_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_event_index"],
          "properties": {
            "source_event_index": {"type": "integer", "minimum": 0, "maximum": 99},
            "source_event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applied", "profile"],
          "properties": {
            "applied": {"type": "boolean"},
            "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
          }
        }
      }
    },
    "input_truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_authenticity_verified",
        "actor_identity_verified",
        "authorization_verified",
        "evaluation_performed",
        "action_authorized",
        "production_ready"
      ],
      "properties": {
        "source_event_authenticity_verified": {"const": false},
        "actor_identity_verified": {"const": false},
        "authorization_verified": {"const": false},
        "evaluation_performed": {"const": false},
        "action_authorized": {"const": false},
        "production_ready": {"const": false}
      }
    }
  }
}
