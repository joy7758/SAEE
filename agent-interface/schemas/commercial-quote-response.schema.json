    "quote_status": {"const": "owner_pricing_review_required"},
    "public_price_points_approved": {"const": false},
    "payment_enabled": {"const": false},
    "customer_contacted": {"const": false},
    "production_ready": {"const": false},
    "blockers_closed": {"const": 0}
  }
}
