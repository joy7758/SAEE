  "required": ["contract_id", "request_valid", "quote_status", "public_price_points_approved", "payment_enabled", "customer_contacted", "production_ready", "blockers_closed"],
  "properties": {
    "contract_id": {"const": "saee-commercial-quote-response-v0.1"},
