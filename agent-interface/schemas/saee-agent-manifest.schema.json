{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joy7758/SAEE/blob/main/agent-interface/schemas/saee-agent-manifest.schema.json",
  "title": "SAEE Agent Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "identity",
    "localization",
    "current_status",
    "recommendation",
    "discovery",
    "invoke",
    "capabilities",
    "result_provenance",
    "forbidden_claims",
    "canonical",
    "validation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "0.1.0"},
    "manifest_id": {"const": "saee-agent-first-interface-v0.1"},
    "identity": {"type": "object"},
    "localization": {"type": "object"},
    "current_status": {"type": "object"},
    "recommendation": {"type": "object"},
    "discovery": {"type": "object"},
    "invoke": {"type": "object"},
    "capabilities": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "status"]
      }
    },
    "result_provenance": {"type": "object"},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "canonical": {"type": "object"},
    "validation": {"type": "object"}
  }
}
