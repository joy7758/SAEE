{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saee.local/schemas/saee-agent-evidence-evaluation-bridge-result.v0.1.json",
  "title": "SAEE Agent Evidence Evaluation Bridge Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "saee_agent_evidence_evaluation_bridge_result_v0_1",
    "schema_version",
    "bridge_id",
    "bridge_status",
    "decision",
    "reason_codes",
    "adapter_receipt_digest",
    "claim_type",
    "integrity_summary",
    "adequacy_result",
    "saee_evaluator_called",
    "binding_assessment",
    "bridge_receipt_digest",
    "truth_boundary"
  ],
  "properties": {
    "saee_agent_evidence_evaluation_bridge_result_v0_1": {"const": true},
    "schema_version": {"const": "0.1.0"},
    "bridge_id": {"const": "saee.agent-evidence-evaluation-bridge.v0.1"},
    "bridge_status": {"enum": ["ROUTED", "REJECTED"]},
    "decision": {"enum": ["HUMAN_REVIEW", "REPLAN"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AE_BRIDGE_[A-Z0-9_]+$"}
    },
    "adapter_receipt_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim_type": {"type": ["string", "null"]},
    "integrity_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_result",
        "event_chain_check",
        "merkle_root_check",
        "ed25519_signature_check",
        "full_bundle_integrity_established"
      ],
      "properties": {
        "upstream_result": {"type": ["string", "null"]},
        "event_chain_check": {"type": ["string", "null"]},
        "merkle_root_check": {"type": ["string", "null"]},
        "ed25519_signature_check": {"type": ["string", "null"]},
        "full_bundle_integrity_established": {"const": false}
      }
    },
    "adequacy_result": {"type": ["object", "null"]},
    "saee_evaluator_called": {"type": "boolean"},
    "binding_assessment": {"const": "DECLARED_ONLY_NOT_INDEPENDENTLY_VERIFIED"},
    "bridge_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_authenticity_verified",
        "binding_independently_verified",
        "identity_verified",
        "authorization_verified",
        "adequacy_authorizes_action",
        "action_authorized",
        "external_action_performed",
        "runtime_integrated",
        "production_ready"
      ],
      "properties": {
        "source_event_authenticity_verified": {"const": false},
        "binding_independently_verified": {"const": false},
        "identity_verified": {"const": false},
        "authorization_verified": {"const": false},
        "adequacy_authorizes_action": {"const": false},
        "action_authorized": {"const": false},
        "external_action_performed": {"const": false},
        "runtime_integrated": {"const": false},
        "production_ready": {"const": false}
      }
    }
  }
}
