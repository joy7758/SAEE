{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAEE Sanitized Observed Trace Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "source", "candidates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "0.1.0"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "source": {"$ref": "#/$defs/SourceAttestation"},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/ObservedCandidate"}
    }
  },
  "$defs": {
    "SourceAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_id", "capture_method", "sanitization_attested", "source_authorized", "raw_content_excluded"],
      "properties": {
        "producer_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "capture_method": {"enum": ["exported_trace", "replay_log", "benchmark_run"]},
        "sanitization_attested": {"const": true},
        "source_authorized": {"const": true},
        "raw_content_excluded": {"const": true}
      }
    },
    "EvidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "metric_name", "metric_min", "metric_max", "higher_is_better", "horizon_unit", "expected_horizon", "failure_definition"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "metric_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "metric_min": {"const": 0.0},
        "metric_max": {"const": 1.0},
        "higher_is_better": {"const": true},
        "horizon_unit": {"enum": ["step", "turn", "episode"]},
        "expected_horizon": {"type": "integer", "minimum": 2, "maximum": 100000},
        "failure_definition": {"const": "alive_false_or_normalized_failure_code"}
      }
    },
    "ObservedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "quality_score", "alive", "failure_code", "failure_severity"],
      "properties": {
        "step": {"type": "integer", "minimum": 0},
        "quality_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "alive": {"type": "boolean"},
        "failure_code": {"enum": ["none", "timeout", "tool_error", "policy_violation", "invalid_output", "resource_exhaustion", "other"]},
        "failure_severity": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "ObservedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "censored", "steps"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "censored": {"type": "boolean"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/ObservedStep"}
        }
      }
    },
    "ObservedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "context", "runs"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "context": {"$ref": "#/$defs/EvidenceContext"},
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/ObservedRun"}
        }
      }
    }
  }
}
