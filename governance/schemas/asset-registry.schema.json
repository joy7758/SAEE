{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saee.local/governance/schemas/asset-registry.schema.json",
  "title": "SAEE Phase 0 Asset Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "authority", "phase0_baseline", "assets"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "saee.phase0.asset-registry"},
    "authority": {"type": "string", "minLength": 1},
    "phase0_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "repository", "branch", "git_head", "worktree_clean", "dirty_entry_count"],
      "properties": {
        "captured_at": {"type": "string", "format": "date-time"},
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "git_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "worktree_clean": {"type": "boolean"},
        "dirty_entry_count": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "role", "location", "owner", "status", "source", "relationship", "migration", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["repository", "runtime", "website", "marketplace", "protocol", "schema", "document", "adapter", "backup"]},
        "role": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "MAINTENANCE", "EXPERIMENTAL", "ARCHIVED", "UNKNOWN"]},
        "source": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1},
        "migration": {"enum": ["KEEP", "MIGRATE", "MERGE", "DEPRECATE", "UNKNOWN"]},
        "notes": {"type": "string"}
      }
    }
  }
}
